// ============================================================================

// ATTENDANCE

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

// ============================================================================
// ATTENDANCE MANAGEMENT (Enhanced)
// ============================================================================
// NOTE: Attendance table will grow to billions of rows at scale.
// Consider partitioning by:
// - Range partitioning by date (monthly/yearly partitions)
// - Retention policy: Archive data older than 3 years to cold storage
// - Separate analytics database for historical reporting

enum AttendanceMethod {
  MANUAL
  BIOMETRIC_FINGERPRINT
  BIOMETRIC_FACE
  RFID_CARD
  QR_CODE
  GPS_LOCATION
  ONLINE_CLASS
  MOBILE_APP
}

// Device registry for attendance
model AttendanceDevice {
  id       String @id @default(uuid())
  schoolId String

  deviceId   String @unique
  deviceName String
  deviceType String // FINGERPRINT_SCANNER, FACE_RECOGNITION, RFID_READER, QR_SCANNER

  location String? // Gate, Classroom, etc.
  roomId   String?

  ipAddress  String?
  macAddress String?

  isActive Boolean @default(true)

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biometricLogs BiometricAttendanceLog[]

  @@index([schoolId])
  @@index([deviceId])
  @@map("attendance_devices")
}

model Attendance {
  id        String  @id @default(uuid())
  studentId String
  schoolId  String
  sectionId String? // Changed from classId

  date   DateTime @db.Date
  period Int? // Period number, null for full day

  status AttendanceStatus
  method AttendanceMethod @default(MANUAL)

  checkInTime  DateTime?
  checkOutTime DateTime?

  location Json? // GPS coordinates if applicable
  deviceId String? // If marked via device

  remarks String?

  markedBy String?
  markedAt DateTime @default(now())

  correctionRequested Boolean   @default(false)
  correctionReason    String?
  correctedBy         String?
  correctedAt         DateTime?

  biometricLogId String? // Reference to biometric log

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, period])
  @@index([studentId])
  @@index([schoolId, date])
  @@index([sectionId, date])
  @@index([status])
  @@index([method])
  @@index([schoolId, sectionId, date])
  @@index([studentId, status])
  @@map("attendance")
}

model TeacherAttendance {
  id        String  @id @default(uuid())
  teacherId String
  schoolId  String?

  date DateTime @db.Date

  status AttendanceStatus
  method AttendanceMethod @default(MANUAL)

  checkInTime  DateTime?
  checkOutTime DateTime?

  location Json? // GPS coordinates if applicable
  deviceId String?

  remarks String?

  markedBy String?
  markedAt DateTime @default(now())

  biometricLogId String?

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([schoolId, date])
  @@index([date])
  @@index([status])
  @@map("teacher_attendance")
}

// Biometric attendance logs (raw data)
// NOTE: Very high-volume table - partition by timestamp (daily/weekly)
// Consider separate time-series database for GPS/biometric logs
model BiometricAttendanceLog {
  id       String @id @default(uuid())
  deviceId String

  userId   String // Student or Teacher
  userType String // STUDENT, TEACHER, STAFF

  biometricType String // FINGERPRINT, FACE, IRIS
  biometricData String? // Hash/reference, not actual biometric

  matchScore Decimal? @db.Decimal(5, 2) // Confidence score

  timestamp DateTime @default(now())

  isVerified Boolean @default(true)

  processed   Boolean   @default(false)
  processedAt DateTime?

  device AttendanceDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([userId, timestamp])
  @@index([processed])
  @@index([deviceId, timestamp]) // Composite for device logs
  @@map("biometric_attendance_logs")
}

// TIMETABLE

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ============================================================================
// TIMETABLE MANAGEMENT (Normalized)
// ============================================================================

// Room/Classroom master
model Room {
  id       String @id @default(uuid())
  schoolId String

  roomNumber String
  roomName   String?

  roomType String @default("CLASSROOM") // CLASSROOM, LAB, AUDITORIUM, LIBRARY, SPORTS

  floor    String?
  building String?

  capacity Int?

  facilities String[] // PROJECTOR, AC, SMART_BOARD, etc.

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([schoolId, roomNumber])
  @@index([schoolId])
  @@map("rooms")
}

// Time slots for periods
model TimeSlot {
  id       String @id @default(uuid())
  schoolId String

  slotName   String // Period 1, Period 2, Lunch, etc.
  slotNumber Int

  startTime String // HH:MM format
  endTime   String // HH:MM format

  duration Int // minutes

  isBreak Boolean @default(false)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([schoolId, slotNumber, effectiveFrom])
  @@index([schoolId])
  @@map("time_slots")
}

// Timetable entry (combination of class, day, slot, teacher, subject, room)
model TimetableEntry {
  id             String @id @default(uuid())
  schoolId       String
  sectionId      String // Changed from classId
  academicYearId String

  dayOfWeek  DayOfWeek
  timeSlotId String

  subjectId String?
  teacherId String?
  roomId    String?

  isSubstitution     Boolean @default(false)
  substitutionReason String?
  originalTeacherId  String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section  Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id])

  @@unique([schoolId, sectionId, dayOfWeek, timeSlotId, effectiveFrom])
  @@index([schoolId])
  @@index([sectionId])
  @@index([teacherId])
  @@index([timeSlotId])
  @@index([roomId])
  @@index([dayOfWeek])
  @@map("timetable_entries")
}

// ============================================================================
// FEE MANAGEMENT (Enhanced)
// ============================================================================

model FeeStructure {
  id       String @id @default(uuid())
  schoolId String

  name        String // e.g., "Grade 1 - Annual Fee"
  description String?

  grade Int?

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  frequency String // ANNUAL, QUARTERLY, MONTHLY, ONE_TIME

  dueDate DateTime? @db.Date

  lateFeeAmount Decimal? @db.Decimal(10, 2)
  lateFeeDays   Int? // Grace period

  isActive Boolean @default(true)

  academicYear String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  feeRecords FeeRecord[]

  @@index([schoolId])
  @@map("fee_structures")
}

model FeeRecord {
  id             String @id @default(uuid())
  studentId      String
  feeStructureId String

  totalAmount   Decimal @db.Decimal(10, 2)
  paidAmount    Decimal @default(0) @db.Decimal(10, 2)
  balanceAmount Decimal @db.Decimal(10, 2)

  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  discountReason String?

  lateFeeAmount Decimal @default(0) @db.Decimal(10, 2)

  status String @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE

  dueDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  payments FeePayment[]

  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
  @@index([studentId, status]) // Composite for filtering
  @@index([feeStructureId, status]) // Composite for reporting
  @@map("fee_records")
}

model FeePayment {
  id          String @id @default(uuid())
  feeRecordId String

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentDate   DateTime      @db.Date

  transactionId String?
  receiptNumber String? @unique

  remarks String?

  createdAt DateTime @default(now())

  feeRecord FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)

  @@index([feeRecordId])
  @@index([receiptNumber])
  @@map("fee_payments")
}

// Fee concessions/discounts
model FeeConcession {
  id             String  @id @default(uuid())
  studentId      String
  feeStructureId String?

  concessionType String // MERIT, SIBLING, ECONOMICALLY_WEAKER, STAFF_WARD, SCHOLARSHIP

  concessionAmount  Decimal  @db.Decimal(10, 2)
  concessionPercent Decimal? @db.Decimal(5, 2)

  reason String?

  approvedBy String
  approvedAt DateTime @default(now())

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([feeStructureId])
  @@map("fee_concessions")
}

// Fee installments
model FeeInstallment {
  id          String @id @default(uuid())
  feeRecordId String

  installmentNumber Int
  installmentAmount Decimal @db.Decimal(10, 2)

  dueDate    DateTime  @db.Date
  paidDate   DateTime? @db.Date
  paidAmount Decimal   @default(0) @db.Decimal(10, 2)

  status String @default("PENDING") // PENDING, PAID, OVERDUE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feeRecordId])
  @@index([status])
  @@map("fee_installments")
}

// Fee refunds
model FeeRefund {
  id           String  @id @default(uuid())
  studentId    String
  feePaymentId String?

  refundAmount Decimal @db.Decimal(10, 2)
  refundReason String

  requestedBy String
  requestedAt DateTime @default(now())

  approvedBy String?
  approvedAt DateTime?

  refundMethod String? // BANK_TRANSFER, CASH, CHEQUE
  refundDate   DateTime? @db.Date

  status String @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED

  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([feePaymentId])
  @@index([status])
  @@map("fee_refunds")
}

// Fee waivers (complete exemption)
model FeeWaiver {
  id             String @id @default(uuid())
  studentId      String
  feeStructureId String

  waiverPercent Decimal @db.Decimal(5, 2)
  waiverAmount  Decimal @db.Decimal(10, 2)

  waiverReason   String
  waiverCategory String // FINANCIAL_HARDSHIP, CALAMITY, SPECIAL_CASE

  supportingDocs String[] // Document URLs

  requestedBy String
  requestedAt DateTime @default(now())

  approvedBy String?
  approvedAt DateTime?

  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
  @@map("fee_waivers")
}

// Scholarships
model Scholarship {
  id       String  @id @default(uuid())
  schoolId String?

  scholarshipName String
  scholarshipType String // MERIT, NEED_BASED, SPORTS, ARTS, GOVERNMENT

  provider String // GOVERNMENT, SCHOOL, NGO, TRUST

  amount     Decimal @db.Decimal(10, 2)
  amountType String // FIXED, PERCENTAGE

  eligibilityCriteria Json

  totalSlots     Int?
  availableSlots Int?

  applicationStart DateTime @db.Date
  applicationEnd   DateTime @db.Date

  disbursementSchedule Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications ScholarshipApplication[]

  @@index([schoolId])
  @@index([isActive])
  @@map("scholarships")
}

model ScholarshipApplication {
  id            String @id @default(uuid())
  scholarshipId String
  studentId     String

  applicationData Json // Form data
  documents       String[] // Document URLs

  status String @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, DISBURSED

  appliedAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewComments String?

  approvedAmount  Decimal? @db.Decimal(10, 2)
  disbursedAmount Decimal  @default(0) @db.Decimal(10, 2)

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
  @@index([studentId])
  @@index([status])
  @@index([scholarshipId, status]) // Composite for scholarship applications
  @@index([studentId, status]) // Composite for student applications
  @@map("scholarship_applications")
}

// Transport fees (separate from academic fees)
model TransportFee {
  id        String @id @default(uuid())
  studentId String
  routeId   String

  monthYear String // YYYY-MM

  feeAmount  Decimal @db.Decimal(10, 2)
  paidAmount Decimal @default(0) @db.Decimal(10, 2)

  status String @default("PENDING") // PENDING, PAID, OVERDUE

  dueDate DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([routeId])
  @@index([status])
  @@map("transport_fees")
}

// ============================================================================
// LIBRARY MANAGEMENT
// ============================================================================

model LibraryBook {
  id       String @id @default(uuid())
  schoolId String

  isbn            String?
  title           String
  author          String?
  publisher       String?
  edition         String?
  publicationYear Int?

  category    String? // FICTION, NON_FICTION, REFERENCE, TEXTBOOK, MAGAZINE, JOURNAL
  subCategory String?

  language String?

  totalCopies     Int
  availableCopies Int
  issuedCopies    Int @default(0)
  damagedCopies   Int @default(0)
  lostCopies      Int @default(0)

  location     String? // Shelf/rack
  deweyDecimal String?

  coverImage  String?
  description String?

  purchaseDate  DateTime? @db.Date
  purchasePrice Decimal?  @db.Decimal(10, 2)

  condition String? // NEW, GOOD, FAIR, POOR

  isActive        Boolean @default(true)
  isReferenceOnly Boolean @default(false)

  tags String[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  issues       LibraryIssue[]
  reservations LibraryReservation[]

  @@index([schoolId])
  @@index([isbn])
  @@index([category])
  @@index([title, author]) // Replace fulltext with regular index
  @@map("library_books")
}

model LibraryIssue {
  id       String @id @default(uuid())
  bookId   String
  userId   String // Can be student, teacher, or staff
  userType String // STUDENT, TEACHER, STAFF

  issueDate  DateTime  @db.Date
  dueDate    DateTime  @db.Date
  returnDate DateTime? @db.Date

  renewalCount Int @default(0)
  maxRenewals  Int @default(2)

  fineAmount Decimal @default(0) @db.Decimal(10, 2)
  finePaid   Boolean @default(false)

  isReturned Boolean @default(false)
  isOverdue  Boolean @default(false)

  condition     String? // GOOD, DAMAGED, LOST
  damageRemarks String?

  remarks String?

  issuedBy   String?
  returnedTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book    LibraryBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student StudentProfile? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@index([userType])
  @@index([isReturned])
  @@index([isOverdue])
  @@index([dueDate])
  @@index([userId, isReturned]) // Composite for user's active issues
  @@index([dueDate, isReturned]) // Composite for overdue tracking
  @@map("library_issues")
}

model LibraryReservation {
  id       String @id @default(uuid())
  bookId   String
  userId   String
  userType String // STUDENT, TEACHER, STAFF

  reservedAt DateTime @default(now())
  expiresAt  DateTime

  status String @default("ACTIVE") // ACTIVE, FULFILLED, EXPIRED, CANCELLED

  notifiedAt DateTime?

  book LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@index([status])
  @@map("library_reservations")
}

model LibraryMember {
  id       String @id @default(uuid())
  userId   String @unique
  userType String // STUDENT, TEACHER, STAFF

  membershipNumber String @unique
  membershipType   String // REGULAR, PREMIUM

  maxBooksAllowed Int @default(3)
  maxDays         Int @default(14)

  isActive Boolean @default(true)

  joinedAt  DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([membershipNumber])
  @@map("library_members")
}

// ============================================================================
// AI & RECOMMENDATION MODELS
// ============================================================================

model AIRecommendation {
  id     String @id @default(uuid())
  userId String

  recommendationType String // CONTENT, LEARNING_PATH, STUDY_PLAN, CAREER, EXAM_STRATEGY

  recommendations Json // Array of recommended items with scores

  modelVersion String? // ML model version used
  confidence   Decimal? @db.Decimal(5, 4)

  reasons Json? // Explanation for recommendations

  isAccepted Boolean?
  acceptedAt DateTime?

  clickedItems String[] // Track which recommendations were clicked

  generatedAt DateTime  @default(now())
  expiresAt   DateTime?

  @@index([userId])
  @@index([recommendationType])
  @@index([generatedAt])
  @@index([userId, recommendationType]) // Composite for user recommendations
  @@map("ai_recommendations")
}

model AIPrediction {
  id        String @id @default(uuid())
  studentId String

  predictionType String // EXAM_SCORE, PASS_FAIL, DROPOUT_RISK, CAREER_FIT

  subjectId String?
  examId    String?

  predictedValue Json // Flexible format for different prediction types
  confidence     Decimal @db.Decimal(5, 4)

  actualValue Json? // For tracking accuracy

  features Json? // Features used in prediction

  modelVersion String

  predictedAt DateTime @default(now())

  @@index([studentId])
  @@index([predictionType])
  @@index([predictedAt])
  @@index([studentId, predictionType]) // Composite for student predictions
  @@map("ai_predictions")
}

model ChatbotConversation {
  id     String @id @default(uuid())
  userId String

  sessionId String

  conversationData Json // Array of messages

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  totalMessages Int @default(0)

  satisfaction Int? // 1-5 rating
  feedback     String?

  @@index([userId])
  @@index([sessionId])
  @@index([startedAt])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String @id @default(uuid())
  conversationId String

  role    String // USER, ASSISTANT, SYSTEM
  content String

  intent   String? // Detected intent
  entities Json? // Extracted entities

  confidence Decimal? @db.Decimal(5, 4)

  isHelpful Boolean?
  feedback  String?

  timestamp DateTime @default(now())

  @@index([conversationId])
  @@index([timestamp])
  @@map("chatbot_messages")
}

model ContentEmbedding {
  id        String @id @default(uuid())
  contentId String @unique

  embeddingModel String // Model used (e.g., "text-embedding-ada-002")
  embedding      String // Vector stored as string/binary

  metadata Json? // Content metadata for filtering

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@map("content_embeddings")
}

model StudentLearningStyle {
  id        String @id @default(uuid())
  studentId String @unique

  visualScore         Decimal @db.Decimal(5, 2)
  auditoryScore       Decimal @db.Decimal(5, 2)
  kinestheticScore    Decimal @db.Decimal(5, 2)
  readingWritingScore Decimal @db.Decimal(5, 2)

  preferredContentTypes String[] // AR, VR, VIDEO, TEXT, INTERACTIVE

  optimalStudyTime String? // MORNING, AFTERNOON, EVENING, NIGHT

  attentionSpan Int? // minutes

  analysisDate DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  @@index([studentId])
  @@map("student_learning_styles")
}

// Enhanced AI Models for Chatbot, Prompts, and Feedback
model AIPrompt {
  id     String @id @default(uuid())
  userId String

  promptText String
  promptType String // QUESTION, COMMAND, CLARIFICATION

  context Json? // Conversation context

  responseText String?
  responseTime Int? // milliseconds

  modelUsed  String? // GPT-4, Claude, etc.
  tokensUsed Int?

  wasSuccessful Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("ai_prompts")
}

model AIFeedback {
  id String @id @default(uuid())

  entityType String // RECOMMENDATION, PREDICTION, CHATBOT_RESPONSE, PROMPT
  entityId   String

  userId String

  rating    Int? // 1-5
  isHelpful Boolean?

  feedbackText String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("ai_feedback")
}

// Vector search support
model VectorIndex {
  id String @id @default(uuid())

  indexName String @unique
  indexType String // CONTENT, QUESTION, DOCUMENT

  dimension Int // Vector dimension (e.g., 1536 for OpenAI)

  totalVectors Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embeddings VectorEmbedding[]

  @@map("vector_indexes")
}

model VectorEmbedding {
  id      String @id @default(uuid())
  indexId String

  entityType String // CONTENT, QUESTION, DOCUMENT, CHAPTER
  entityId   String

  embedding String // Vector as binary/string (use pgvector extension)

  metadata Json? // Searchable metadata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  index VectorIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, entityType, entityId])
  @@index([indexId])
  @@index([entityType, entityId])
  @@map("vector_embeddings")
}

model DocumentChunk {
  id String @id @default(uuid())

  documentId   String // Reference to original document
  documentType String // TEXTBOOK, STUDY_MATERIAL, REFERENCE

  chunkIndex Int
  chunkText  String

  embeddingId String?

  metadata Json? // Page number, section, etc.

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([documentType])
  @@map("document_chunks")
}

model RetrievalQuery {
  id     String @id @default(uuid())
  userId String

  query String

  retrievedChunks Json // Array of relevant chunks with scores

  wasHelpful Boolean?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("retrieval_queries")
}

// AI Infrastructure - Token Usage & Billing
model TokenUsage {
  id             String  @id @default(uuid())
  userId         String
  organizationId String?

  modelProvider String // OPENAI, ANTHROPIC, GOOGLE, AZURE
  modelName     String // gpt-4, claude-3, gemini-pro
  modelVersion  String?

  promptTokens     Int
  completionTokens Int
  totalTokens      Int

  cost Decimal? @db.Decimal(10, 6)

  requestType String // CHAT, EMBEDDING, COMPLETION

  entityType String? // CHATBOT, RECOMMENDATION, PREDICTION
  entityId   String?

  responseTime Int? // milliseconds

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([modelProvider, modelName])
  @@index([createdAt])
  @@map("token_usage")
}

model ModelProvider {
  id String @id @default(uuid())

  name        String @unique // OPENAI, ANTHROPIC, GOOGLE
  displayName String

  apiEndpoint String?

  availableModels Json // List of models with capabilities

  isActive Boolean @default(true)

  rateLimits Json? // Rate limit configs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("model_providers")
}

model PromptTemplate {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  templateText String

  category String // CHATBOT, RECOMMENDATION, ANALYSIS

  variables String[] // Required template variables

  modelProvider String?
  modelName     String?

  temperature Decimal? @db.Decimal(3, 2)
  maxTokens   Int?

  version Int @default(1)

  isActive Boolean @default(true)

  usageCount Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("prompt_templates")
}

model InferenceLog {
  id String @id @default(uuid())

  modelProvider String
  modelName     String

  inputText  String? // Store only if needed for debugging
  outputText String?

  promptTokens     Int
  completionTokens Int

  responseTime Int // milliseconds

  success      Boolean @default(true)
  errorMessage String?

  userId         String?
  organizationId String?

  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([modelProvider, modelName])
  @@index([userId])
  @@index([createdAt])
  @@map("inference_logs")
}

// ============================================================================
// HOSTEL MANAGEMENT (Enhanced ERP Module)
// ============================================================================

model HostelBlock {
  id       String @id @default(uuid())
  schoolId String

  blockName   String
  blockNumber String?
  blockType   String? // BOYS, GIRLS, MIXED, STAFF

  totalFloors   Int @default(1)
  totalRooms    Int
  totalCapacity Int

  wardenName  String?
  wardenPhone String?
  wardenId    String? // User ID

  facilities String[] // COMMON_ROOM, LAUNDRY, CAFETERIA, STUDY_HALL, GYM

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  rooms HostelRoom[]
  fees  HostelFee[]

  @@index([schoolId])
  @@index([blockType])
  @@map("hostel_blocks")
}

model HostelRoom {
  id      String @id @default(uuid())
  blockId String

  roomNumber String
  roomType   String @default("STANDARD") // STANDARD, DELUXE, SUITE

  capacity Int
  occupied Int @default(0)

  floor Int?

  facilities String[] // AC, ATTACHED_BATHROOM, BALCONY, etc.

  monthlyRent Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block HostelBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  assignments        HostelRoomAssignment[]
  maintenanceRecords HostelMaintenance[]

  @@unique([blockId, roomNumber])
  @@index([blockId])
  @@index([roomType])
  @@map("hostel_rooms")
}

model HostelRoomAssignment {
  id        String @id @default(uuid())
  studentId String @unique
  roomId    String

  bedNumber String?

  assignedAt DateTime  @default(now())
  vacatedAt  DateTime?

  status String @default("ACTIVE") // ACTIVE, VACATED, SUSPENDED

  monthlyRent     Decimal  @db.Decimal(10, 2)
  securityDeposit Decimal? @db.Decimal(10, 2)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room    HostelRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([status])
  @@map("hostel_room_assignments")
}

model HostelFee {
  id      String @id @default(uuid())
  blockId String

  feeType String // MONTHLY_RENT, MESS_FEE, SECURITY_DEPOSIT, MAINTENANCE
  amount  Decimal @db.Decimal(10, 2)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  block HostelBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("hostel_fees")
}

model HostelMaintenance {
  id     String @id @default(uuid())
  roomId String

  issueType   String // ELECTRICAL, PLUMBING, FURNITURE, CLEANING
  description String

  reportedBy String
  reportedAt DateTime @default(now())

  assignedTo String?
  assignedAt DateTime?

  status String @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED

  completedAt DateTime?
  completedBy String?

  cost Decimal? @db.Decimal(10, 2)

  room HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([status])
  @@map("hostel_maintenance")
}

// ============================================================================
// INVENTORY MANAGEMENT (Enhanced ERP Module)
// ============================================================================

model InventoryCategory {
  id          String  @id @default(uuid())
  name        String
  description String?

  parentId String?

  parent   InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children InventoryCategory[] @relation("CategoryHierarchy")

  items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id             String  @id @default(uuid())
  schoolId       String?
  organizationId String?

  itemName String
  itemCode String? @unique
  barcode  String? @unique

  categoryId String?

  description String?

  quantity Int     @default(0)
  unit     String? // pieces, boxes, kg, liters, etc.

  minimumStock Int?
  reorderLevel Int?
  maximumStock Int?

  location String? // Warehouse, Room, etc.

  unitPrice  Decimal? @db.Decimal(10, 2)
  totalValue Decimal? @db.Decimal(12, 2)

  isConsumable Boolean @default(false)
  isAsset      Boolean @default(false)

  purchaseDate DateTime? @db.Date
  expiryDate   DateTime? @db.Date

  supplierId String?

  warrantyPeriod Int? // months
  warrantyExpiry DateTime? @db.Date

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category InventoryCategory? @relation(fields: [categoryId], references: [id])

  transactions InventoryTransaction[]
  requisitions InventoryRequisition[]

  @@index([schoolId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([barcode])
  @@map("inventory_items")
}

model InventoryTransaction {
  id     String @id @default(uuid())
  itemId String

  transactionType String // IN, OUT, ADJUSTMENT, TRANSFER, DAMAGED, EXPIRED

  quantity Int

  fromLocation String?
  toLocation   String?

  reference String? // PO number, issue number

  unitPrice  Decimal? @db.Decimal(10, 2)
  totalValue Decimal? @db.Decimal(12, 2)

  performedBy String
  approvedBy  String?

  reason  String?
  remarks String?

  transactionDate DateTime @db.Date
  createdAt       DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([itemId, transactionDate]) // Composite for item history
  @@index([transactionType, transactionDate]) // Composite for transaction reports
  @@map("inventory_transactions")
}

model InventoryRequisition {
  id     String @id @default(uuid())
  itemId String

  requestedBy  String
  requestedFor String? // Department, Event, etc.

  quantity Int
  purpose  String

  status String @default("PENDING") // PENDING, APPROVED, REJECTED, ISSUED

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  String?

  issuedAt       DateTime?
  issuedBy       String?
  issuedQuantity Int?

  rejectedAt      DateTime?
  rejectionReason String?

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([status])
  @@map("inventory_requisitions")
}

model Supplier {
  id String @id @default(uuid())

  supplierName String
  supplierCode String? @unique

  contactPerson String?
  email         String?
  phone         String?

  category String? // STATIONERY, ELECTRONICS, FOOD, etc.

  gstNumber String?
  panNumber String?

  bankDetails Json?

  rating Decimal? @db.Decimal(3, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

