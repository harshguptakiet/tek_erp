// ============================================================================
// NOTIFICATIONS & MESSAGING
// ============================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String

  type String // ASSIGNMENT, EXAM, FEE, ATTENDANCE, etc.

  channels NotificationChannel[] // Channels this was sent through
  priority NotificationPriority  @default(MEDIUM)

  resourceType String? // exam, assignment, content
  resourceId   String?

  isRead Boolean   @default(false)
  readAt DateTime?

  scheduledAt DateTime?
  sentAt      DateTime?

  templateId   String? // Reference to NotificationTemplate
  templateData Json? // Data for template variables

  metadata Json? // Extra data

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([userId, isRead]) // Composite for unread notifications
  @@index([userId, type]) // Composite for filtered notifications
  @@map("notifications")
}

// Notification delivery tracking per channel
// NOTE: High-volume table - consider partitioning by sentAt (monthly)
model NotificationDelivery {
  id             String @id @default(uuid())
  notificationId String

  channel String // EMAIL, SMS, PUSH, IN_APP, WHATSAPP

  recipient String // Email, phone, device token

  status String @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, BOUNCED, OPENED, CLICKED

  attempts Int @default(0)

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  error String?

  gatewayId       String? // External service message ID
  gatewayResponse Json?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@index([sentAt])
  @@map("notification_deliveries")
}

// ============================================================================
// MESSAGING SYSTEM (Enhanced)
// ============================================================================

// Conversation (group or 1-on-1)
model Conversation {
  id String @id @default(uuid())

  conversationType String // ONE_ON_ONE, GROUP, CHANNEL

  name        String? // For groups
  description String?

  avatarUrl String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastMessageAt      DateTime?
  lastMessagePreview String?

  isArchived Boolean @default(false)

  metadata Json?

  participants MessageParticipant[]
  messages     Message[]

  @@index([conversationType])
  @@index([lastMessageAt])
  @@map("conversations")
}

// Participants in a conversation
model MessageParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  role String @default("MEMBER") // ADMIN, MEMBER

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  lastReadAt DateTime?

  isMuted  Boolean @default(false)
  isPinned Boolean @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("message_participants")
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  senderId       String

  // Legacy fields for backward compatibility
  recipientId String?
  groupId     String?

  subject String?
  body    String

  messageType String @default("TEXT") // TEXT, IMAGE, VIDEO, FILE, AUDIO, LOCATION

  replyToId String? // For threaded replies

  isEdited Boolean   @default(false)
  editedAt DateTime?

  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedFor String[] // User IDs who deleted this message

  sentAt DateTime @default(now())

  metadata Json?

  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])

  replies      Message[]            @relation("MessageReplies")
  attachments  MessageAttachment[]
  reactions    MessageReaction[]
  readReceipts MessageReadReceipt[]

  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([groupId])
  @@index([sentAt])
  @@index([replyToId])
  @@index([conversationId, sentAt]) // Composite for message timeline
  @@index([senderId, sentAt]) // Composite for user's sent messages
  @@map("messages")
}

// Message attachments
model MessageAttachment {
  id        String @id @default(uuid())
  messageId String

  fileName String
  fileUrl  String
  fileType String // image/jpeg, application/pdf, etc.
  fileSize Int // bytes

  thumbnailUrl String?

  uploadedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// Read receipts
model MessageReadReceipt {
  id        String @id @default(uuid())
  messageId String
  userId    String

  readAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_read_receipts")
}

// Message reactions (emoji reactions)
model MessageReaction {
  id        String @id @default(uuid())
  messageId String
  userId    String

  emoji String // Unicode emoji

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// Pinned messages in conversation
model PinnedMessage {
  id             String @id @default(uuid())
  conversationId String
  messageId      String

  pinnedBy String
  pinnedAt DateTime @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("pinned_messages")
}

// ============================================================================
// PREVIOUS MODELS CONTINUE BELOW
// ============================================================================

model MessageGroup {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdBy String

  members String[] // Array of user IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_groups")
}

model Announcement {
  id             String  @id @default(uuid())
  schoolId       String?
  organizationId String?

  title   String
  content String

  targetRoleIds String[] // Role IDs instead of relation
  targetClasses String[] // Class IDs

  attachments String[] // S3 URLs

  publishedAt DateTime?
  expiresAt   DateTime?

  isPinned Boolean @default(false)

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([publishedAt])
  @@map("announcements")
}

// ============================================================================
// AUDIT & LOGGING
// ============================================================================

model AuditLog {
  id     String  @id @default(uuid())
  userId String?

  // Tenant context
  tenantId       String?
  organizationId String?
  schoolId       String?

  action String // LOGIN, CREATE, UPDATE, DELETE, APPROVE, REJECT, etc.

  // Table-level tracking
  tableName String // The database table/model name
  recordId  String? // The ID of the affected record

  // Column-level tracking (for UPDATE actions)
  columnName String? // Specific column changed
  oldValue   String? // Old value (JSON stringified)
  newValue   String? // New value (JSON stringified)

  // Legacy field for backward compatibility
  resource   String? // Deprecated: use tableName
  resourceId String? // Deprecated: use recordId
  changes    Json? // Deprecated: use columnName/oldValue/newValue

  // Request context
  ipAddress String?
  userAgent String?
  device    String? // Device type/name
  browser   String?
  os        String?

  // Location
  location Json? // City, country, coordinates

  // Additional context
  reason   String? // Why the action was performed
  metadata Json? // Any additional context

  // API context
  apiEndpoint String?
  httpMethod  String?

  // Security
  riskLevel String? // LOW, MEDIUM, HIGH, CRITICAL
  flagged   Boolean @default(false)

  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([schoolId])
  @@index([tableName])
  @@index([recordId])
  @@index([tableName, recordId])
  @@index([action])
  @@index([timestamp])
  @@index([ipAddress])
  @@index([flagged])
  @@index([tenantId, timestamp]) // Composite for tenant audit logs
  @@index([organizationId, timestamp]) // Composite for org audit logs
  @@index([userId, timestamp]) // Composite for user activity
