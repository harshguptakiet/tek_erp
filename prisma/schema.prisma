// ============================================================================

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  LONG_ANSWER
  MATCH_FOLLOWING
  DIAGRAM_BASED
}

model QuestionBank {
  id        String  @id @default(uuid())
  creatorId String?

  question     String
  questionType QuestionType

  options       Json? // For MCQ, Match following
  correctAnswer Json // Flexible format

  explanation String?

  board     Board?
  grade     Int?
  subjectId String?
  chapterId String?
  topicId   String?

  difficultyLevel DifficultyLevel?
  bloomsTaxonomy  String? // Remember, Understand, Apply, Analyze, Evaluate, Create

  marks         Decimal  @db.Decimal(5, 2)
  negativeMarks Decimal? @db.Decimal(5, 2)

  estimatedTime Int? // seconds

  boardExamFrequency Int? // How many times appeared in board exams
  lastAppearedYear   Int?

  hasImage Boolean @default(false)
  hasVideo Boolean @default(false)
  hasAR    Boolean @default(false)
  hasVR    Boolean @default(false)

  mediaUrls String[]

  tags     String[]
  keywords String[]

  usageCount Int @default(0)

  isPublic Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examQuestions ExamQuestion[]

  @@index([board, grade, subjectId])
  @@index([difficultyLevel])
  @@index([board, grade, subjectId, difficultyLevel]) // Composite for question filtering
  @@index([isPublic, isActive]) // Composite for available questions
  @@index([question, keywords]) // Replace fulltext with regular index
  @@map("question_bank")
}

enum ExamType {
  QUIZ
  MOCK_TEST
  ASSIGNMENT
  MID_TERM
  FINAL_EXAM
  COMPETITIVE_EXAM
  PRACTICE_TEST
}

model Exam {
  id        String  @id @default(uuid())
  teacherId String?
  sectionId String? // Changed from classId

  title       String
  description String?

  examType ExamType

  board     Board?
  grade     Int?
  subjectId String?

  totalMarks   Decimal  @db.Decimal(7, 2)
  passingMarks Decimal? @db.Decimal(7, 2)

  duration Int // minutes

  hasNegativeMarking Boolean @default(false)

  randomizeQuestions Boolean @default(false)
  randomizeOptions   Boolean @default(false)

  showResultsImmediately Boolean @default(true)
  showCorrectAnswers     Boolean @default(true)

  allowReview Boolean @default(true)

  blueprint Json? // Chapter-wise marks distribution

  startTime DateTime?
  endTime   DateTime?

  isPublished Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  teacher TeacherProfile? @relation(fields: [teacherId], references: [id])
  section Section?        @relation(fields: [sectionId], references: [id])

  questions   ExamQuestion[]
  attempts    ExamAttempt[]
  assignments ExamAssignment[]

  @@index([teacherId])
  @@index([sectionId])
  @@index([examType])
  @@map("exams")
}

model ExamQuestion {
  id             String  @id @default(uuid())
  examId         String
  questionBankId String?

  questionOrder Int

  // Denormalized for exam snapshot
  question      String
  questionType  QuestionType
  options       Json?
  correctAnswer Json
  explanation   String?

  marks         Decimal  @db.Decimal(5, 2)
  negativeMarks Decimal? @db.Decimal(5, 2)

  sectionName String? // For sectioned exams

  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionBank QuestionBank? @relation(fields: [questionBankId], references: [id])

  answers ExamAnswer[]

  @@unique([examId, questionOrder])
  @@index([examId])
  @@map("exam_questions")
}

model ExamAssignment {
  id        String  @id @default(uuid())
  examId    String
  studentId String?
  classId   String?
  groupName String? // For random groups

  assignedAt DateTime @default(now())
  assignedBy String?

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
  @@index([classId])
  @@map("exam_assignments")
}

model ExamAttempt {
  id        String @id @default(uuid())
  examId    String
  studentId String

  attemptNumber Int @default(1)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  timeTaken Int? // seconds

  totalMarks    Decimal? @db.Decimal(7, 2)
  obtainedMarks Decimal? @db.Decimal(7, 2)
  percentage    Decimal? @db.Decimal(5, 2)

  rank Int?

  isPassed Boolean?

  evaluatedAt DateTime?
  evaluatedBy String?

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  answers ExamAnswer[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId])
  @@index([studentId])
  @@index([examId, studentId]) // Composite for querying attempts
  @@index([studentId, submittedAt]) // Composite for timeline
  @@map("exam_attempts")
}

model ExamAnswer {
  id         String @id @default(uuid())
  attemptId  String
  questionId String

  answer Json // Student's answer

  isCorrect    Boolean?
  marksAwarded Decimal? @db.Decimal(5, 2)

  timeTaken Int? // seconds

  feedback String? // For manual grading

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("exam_answers")
}

