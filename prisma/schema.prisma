// Edubharti Platform - Complete Database Schema
// Technology: PostgreSQL with Prisma ORM
// Architecture: Multi-tenant B2B + B2C Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ============================================================================
// CORE AUTHENTICATION & USER MANAGEMENT
// ============================================================================

// Minimal enum for system-level identification only
enum SystemRole {
  PLATFORM_ADMIN // Platform super admin
  GOVERNMENT // Government officials
  ORG_OWNER // Organization owner
  ORG_ADMIN // Organization admin
  SCHOOL_ADMIN // School level admin
  TEACHER // Teacher
  STUDENT // Student
  PARENT // Parent
  PUBLISHER // Content publisher
  CREATOR // Content creator
  GUEST // Guest/trial user
}

// Actual roles are in Role table for flexibility

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  AADHAAR
  SCHOOL_ID
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

model User {
  id           String  @id @default(uuid())
  email        String? @unique
  phone        String? @unique
  aadhaarLast4 String? // Only last 4 digits for display (XXXX-XXXX-1234)
  username     String? @unique
  passwordHash String?

  firstName    String
  lastName     String
  middleName   String?
  dateOfBirth  DateTime?
  gender       String?
  profileImage String?

  role         SystemRole // Changed from UserRole to SystemRole
  status       UserStatus   @default(PENDING_VERIFICATION)
  authProvider AuthProvider @default(LOCAL)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  backupCodes      String[] // Hashed 2FA backup codes

  passwordExpiry     DateTime?
  lastPasswordChange DateTime?

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  lastLogin           DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  tenantId String? // For multi-tenancy

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  userSessions      UserSession[]
  userRoles         UserRoleMapping[]
  userRolesNew      UserRole[]         @relation("UserRoles") // New RBAC system
  customPermissions CustomPermission[]
  organizations     OrganizationUser[]
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  parentProfile     ParentProfile?
  publisherProfile  PublisherProfile?
  creatorProfile    CreatorProfile?

  auditLogs     AuditLog[]
  notifications Notification[]
  messages      Message[]      @relation("MessageSender")

  @@index([email])
  @@index([phone])
  @@index([tenantId])
  @@index([role, status])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  deviceInfo   String?  // Changed from Json to String for simplified device info
  ipAddress    String?
  location     String?  // Geographic location from IP
  userAgent    String?
  isActive     Boolean  @default(true) // Track active sessions
  expiresAt    DateTime

  createdAt    DateTime @default(now())
  lastActivity DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, isActive])
  @@map("user_sessions")
}

// Custom Role-Based Access Control (for B2B dynamic roles)
model CustomRole {
  id             String  @id @default(uuid())
  name           String
  description    String?
  organizationId String?

  isSystemRole Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions  CustomPermission[]
  users        UserRoleMapping[]
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("custom_roles")
}

model CustomPermission {
  id     String  @id @default(uuid())
  roleId String
  userId String?

  resource   String // e.g., "attendance", "fees", "content"
  action     String // e.g., "create", "read", "update", "delete"
  conditions Json? // Custom conditions

  createdAt DateTime @default(now())

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([userId])
  @@map("custom_permissions")
}

model UserRoleMapping {
  id             String  @id @default(uuid())
  userId         String
  roleId         String
  organizationId String?

  assignedAt DateTime @default(now())
  assignedBy String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         CustomRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_mappings")
}

// ============================================================================
// COMPREHENSIVE RBAC SYSTEM (Replacing CustomRole/CustomPermission)
// ============================================================================

// This model replaces CustomRole for proper RBAC
model Role {
  id          String  @id @default(uuid())
  name        String
  displayName String
  description String?

  organizationId String? // NULL for platform-level roles

  isSystemRole Boolean @default(false) // Cannot be deleted
  isActive     Boolean @default(true)

  priority Int @default(100) // Lower number = higher priority

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  userRoles   UserRole[]
  childRoles  RoleInheritance[] @relation("ParentRole")
  parentRoles RoleInheritance[] @relation("ChildRole")

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([isActive])
  @@map("roles")
}

// Permission categories for organization
model PermissionCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String
  description String?

  sortOrder Int @default(0)

  permissions Permission[]

  @@map("permission_categories")
}

// Permission groups (sub-categories)
model PermissionGroup {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String
  description String?

  categoryId String?

  sortOrder Int @default(0)

  permissions Permission[]

  @@index([categoryId])
  @@map("permission_groups")
}

// Core permission model - 300+ permissions stored here
model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "users.create", "attendance.view"
  displayName String
  description String?

  categoryId String?
  groupId    String?

  resource String // e.g., "users", "attendance", "fees"
  action   String // e.g., "create", "read", "update", "delete", "approve"

  scope String @default("ORGANIZATION") // PLATFORM, ORGANIZATION, SCHOOL, CLASS

  isSystemPermission Boolean @default(false) // Cannot be deleted
  isActive           Boolean @default(true)

  riskLevel String @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category PermissionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group    PermissionGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  rolePermissions RolePermission[]
  dependencies    PermissionDependency[] @relation("RequiredPermission")
  dependents      PermissionDependency[] @relation("DependentPermission")

  @@index([resource, action])
  @@index([categoryId])
  @@index([groupId])
  @@map("permissions")
}

// Many-to-many between Role and Permission
model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  // Optional conditions for conditional permissions
  conditions Json? // e.g., {"departmentId": "dept-123", "classId": "class-456"}

  grantedAt DateTime @default(now())
  grantedBy String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Permission dependencies (e.g., "fees.approve" requires "fees.view")
model PermissionDependency {
  id                   String @id @default(uuid())
  permissionId         String // The dependent permission
  requiredPermissionId String // The required permission

  isStrict Boolean @default(true) // If true, dependent cannot exist without required

  permission         Permission @relation("DependentPermission", fields: [permissionId], references: [id], onDelete: Cascade)
  requiredPermission Permission @relation("RequiredPermission", fields: [requiredPermissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, requiredPermissionId])
  @@index([permissionId])
  @@index([requiredPermissionId])
  @@map("permission_dependencies")
}

// Role inheritance (role hierarchy)
model RoleInheritance {
  id           String @id @default(uuid())
  parentRoleId String
  childRoleId  String

  createdAt DateTime @default(now())

  parentRole Role @relation("ParentRole", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRole  Role @relation("ChildRole", fields: [childRoleId], references: [id], onDelete: Cascade)

  @@unique([parentRoleId, childRoleId])
  @@index([parentRoleId])
  @@index([childRoleId])
  @@map("role_inheritances")
}

// User to Role mapping (replaces direct role field)
model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  // Scope of the role assignment
  scopeType String? // PLATFORM, ORGANIZATION, SCHOOL, BRANCH, CLASS
  scopeId   String? // ID of the scope entity

  assignedAt DateTime @default(now())
  assignedBy String?

  expiresAt DateTime?

  isActive Boolean @default(true)

  user User @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@map("user_roles")
}

// ============================================================================
// USER MODEL DECOMPOSITION (Splitting the God Table)
// ============================================================================

// Authentication specific data
model UserAuthentication {
  id     String @id @default(uuid())
  userId String @unique

  passwordHash       String?
  passwordExpiry     DateTime?
  lastPasswordChange DateTime?

  authProvider AuthProvider @default(LOCAL)

  googleId    String? @unique
  microsoftId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_authentications")
}

// Security settings
model UserSecurity {
  id     String @id @default(uuid())
  userId String @unique

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  passwordResetRequired Boolean @default(false)

  securityQuestions Json? // Array of Q&A

  trustedDevices String[] // Device IDs

  lastSecurityAudit DateTime?

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_security")
}

// User profile data
model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  firstName  String
  lastName   String
  middleName String?

  dateOfBirth DateTime?
  gender      String?

  profileImage String?
  coverImage   String?

  bio   String?
  about String?

  bloodGroup String?

  nationality String?
  religion    String?
  category    String? // General, OBC, SC, ST

  fatherName   String?
  motherName   String?
  guardianName String?

  languages String[] // Known languages

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_profiles")
}

// Contact information
model UserContactInfo {
  id     String @id @default(uuid())
  userId String @unique

  email           String?   @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phone           String?   @unique
  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  alternateEmail String?
  alternatePhone String?

  whatsappNumber String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("user_contact_info")
}

// Verification status
model UserVerification {
  id     String @id @default(uuid())
  userId String @unique

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  aadhaarVerified   Boolean   @default(false)
  aadhaarVerifiedAt DateTime?

  documentVerified   Boolean   @default(false)
  documentVerifiedAt DateTime?

  documentsSubmitted Json? // Array of document types

  verificationStatus String @default("PENDING") // PENDING, PARTIAL, COMPLETE

  verifiedBy        String?
  verificationNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_verifications")
}

// Login history
model UserLoginHistory {
  id     String @id @default(uuid())
  userId String

  loginAt  DateTime  @default(now())
  logoutAt DateTime?

  ipAddress String?
  userAgent String?
  device    String? // Device type/name
  browser   String?
  os        String?

  location Json? // City, country, coordinates

  loginMethod String @default("PASSWORD") // PASSWORD, OTP, GOOGLE, MICROSOFT, BIOMETRIC

  success       Boolean @default(true)
  failureReason String?

  sessionId String?

  @@index([userId])
  @@index([loginAt])
  @@map("user_login_history")
}

// User preferences
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique

  language   String @default("en")
  timezone   String @default("Asia/Kolkata")
  dateFormat String @default("DD/MM/YYYY")
  timeFormat String @default("24h")

  theme String @default("light") // light, dark, auto

  notificationSettings Json? // Per-type notification preferences

  privacySettings Json? // Privacy preferences

  contentPreferences Json? // Preferred content types, subjects

  accessibility Json? // Screen reader, font size, high contrast

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_preferences")
}

// Sensitive data (encrypted)
model UserSensitiveData {
  id     String @id @default(uuid())
  userId String @unique

  // Encrypted Aadhaar (never store plain)
  aadhaarHash      String? @unique // SHA-256 hash for lookup
  aadhaarEncrypted String? // AES-256 encrypted
  aadhaarMasked    String? // XXXX-XXXX-1234

  // Other sensitive IDs
  panNumber      String?
  passportNumber String?

  // Bank details (encrypted)
  bankAccountEncrypted Json? // Encrypted bank details

  // Medical information
  medicalConditions String[] // Encrypted if needed
  allergies         String[]

  // All encrypted with application-level encryption
  encryptionKeyId String? // Reference to encryption key version

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([aadhaarHash])
  @@map("user_sensitive_data")
}

// ============================================================================
// GEOGRAPHY & MASTER DATA
// ============================================================================

model Country {
  id        String  @id @default(uuid())
  code      String  @unique // ISO 3166-1
  name      String
  phoneCode String?
  currency  String?

  isActive Boolean @default(true)

  states State[]

  @@map("countries")
}

model State {
  id        String @id @default(uuid())
  countryId String
  code      String // State code
  name      String

  isActive Boolean @default(true)

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  districts District[]

  @@unique([countryId, code])
  @@index([countryId])
  @@map("states")
}

model District {
  id      String @id @default(uuid())
  stateId String
  code    String
  name    String

  isActive Boolean @default(true)

  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)

  blocks Block[]

  @@unique([stateId, code])
  @@index([stateId])
  @@map("districts")
}

model Block {
  id         String  @id @default(uuid())
  districtId String
  code       String?
  name       String

  isActive Boolean @default(true)

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  villages Village[]

  @@index([districtId])
  @@map("blocks")
}

model Village {
  id      String  @id @default(uuid())
  blockId String
  code    String?
  name    String

  pincode String?

  isActive Boolean @default(true)

  block Block @relation(fields: [blockId], references: [id], onDelete: Restrict)

  @@index([blockId])
  @@map("villages")
}

// ============================================================================
// ADDRESS MODEL (Normalized)
// ============================================================================

model Address {
  id String @id @default(uuid())

  addressType String // HOME, OFFICE, SCHOOL, BRANCH

  line1    String
  line2    String?
  landmark String?

  cityTown String

  stateId    String?
  districtId String?
  blockId    String?
  villageId  String?

  pincode String?

  countryId String

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  // Polymorphic relations
  entityType String // USER, ORGANIZATION, SCHOOL, BRANCH
  entityId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([stateId])
  @@index([districtId])
  @@index([pincode])
  @@map("addresses")
}

// ============================================================================
// PROPER MULTI-TENANT HIERARCHY
// ============================================================================

// Platform → Government → Organization → School → Branch → Department → Class → Section

enum TenantLevel {
  PLATFORM
  GOVERNMENT_NATIONAL
  GOVERNMENT_STATE
  GOVERNMENT_DISTRICT
  ORGANIZATION
  SCHOOL
  BRANCH
  DEPARTMENT
}

model TenantHierarchy {
  id String @id @default(uuid())

  level TenantLevel

  // Self-referential hierarchy
  parentId String?

  // Denormalized path for fast queries
  hierarchyPath  String // Format: "/platform_id/gov_id/org_id/school_id"
  hierarchyLevel Int    @default(0)

  // Entity reference
  entityType String // PLATFORM, GOVERNMENT, ORGANIZATION, SCHOOL, BRANCH
  entityId   String

  name String
  code String?

  isActive Boolean @default(true)

  parent   TenantHierarchy?  @relation("TenantTree", fields: [parentId], references: [id])
  children TenantHierarchy[] @relation("TenantTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([parentId])
  @@index([hierarchyPath])
  @@index([entityType, entityId])
  @@map("tenant_hierarchy")
}

// ============================================================================
// GOVERNMENT ENTITIES
// ============================================================================

model GovernmentEntity {
  id String @id @default(uuid())

  level String // NATIONAL, STATE, DISTRICT

  name String
  code String? @unique

  // Geography linkage
  countryId  String?
  stateId    String?
  districtId String?

  // Hierarchy
  parentId String?
  tenantId String  @unique // Links to TenantHierarchy

  contactEmail String?
  contactPhone String?

  officerInCharge String?
  designation     String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   GovernmentEntity?  @relation("GovHierarchy", fields: [parentId], references: [id])
  children GovernmentEntity[] @relation("GovHierarchy")

  @@index([tenantId])
  @@index([level])
  @@index([stateId])
  @@index([districtId])
  @@map("government_entities")
}

enum OrganizationType {
  MINISTRY
  STATE_DEPARTMENT
  DISTRICT_OFFICE
  SCHOOL
  COLLEGE
  UNIVERSITY
  COACHING_CENTER
  INSTITUTION_GROUP
  EDTECH_COMPANY
}

enum OrganizationTier {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
  GOVERNMENT
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  legalName String?
  type      OrganizationType
  tier      OrganizationTier @default(BASIC)

  registrationNumber String? @unique
  taxId              String?
  gstin              String? // GST Number

  email   String?
  phone   String?
  website String?

  // Address is now normalized in Address table
  // Use: Address where entityType = "ORGANIZATION" and entityId = this.id

  // Geography linkage
  countryId  String?
  stateId    String?
  districtId String?

  coordinates Json? // {lat, lng}

  logo           String?
  banner         String?
  brandingConfig Json? // White-label branding

  // Multi-tenancy hierarchy
  parentOrganizationId String?
  tenantId             String  @unique
  hierarchyPath        String? // Denormalized path like "/org1/org2/org3"
  hierarchyLevel       Int     @default(0)

  // Features & Settings
  enabledModules String[] // LMS, ERP, MARKETPLACE, ANALYTICS, etc.
  customDomain   String?  @unique

  // Limits based on tier
  maxSchools   Int?
  maxStudents  Int?
  maxTeachers  Int?
  storageLimit Int? // GB

  // Contact person
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?

  // Status
  isActive    Boolean   @default(true)
  isTrial     Boolean   @default(false)
  trialEndsAt DateTime?

  onboardedAt DateTime @default(now())
  onboardedBy String?

  // Compliance
  dataResidency   String? // INDIA, EU, US
  complianceFlags Json? // GDPR, ISO, etc.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  parentOrganization Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations Organization[] @relation("OrganizationHierarchy")

  branches    Branch[]
  departments Department[]

  users            OrganizationUser[]
  customRoles      CustomRole[]
  userRoleMappings UserRoleMapping[]
  roles            Role[] // New RBAC system

  schools       School[]
  subscriptions Subscription[]
  licenses      License[]

  @@index([tenantId])
  @@index([type])
  @@index([parentOrganizationId])
  @@index([hierarchyPath])
  @@index([stateId])
  @@index([districtId])
  @@index([isActive])
  @@map("organizations")
}

// Branch within organization (physical locations)
model Branch {
  id             String @id @default(uuid())
  organizationId String

  name String
  code String

  branchType String // HEADQUARTERS, REGIONAL, LOCAL

  // Geography linkage
  countryId  String?
  stateId    String?
  districtId String?

  // Hierarchy
  tenantId      String  @unique
  hierarchyPath String?

  headOfBranch String? // User ID

  contactEmail String?
  contactPhone String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departments Department[]
  schools     School[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([tenantId])
  @@map("branches")
}

// Department within organization/branch
model Department {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String?

  name String
  code String

  departmentType String // ACADEMIC, ADMINISTRATIVE, HR, FINANCE, IT, OPERATIONS

  // Hierarchy
  parentDepartmentId String?
  tenantId           String  @unique
  hierarchyPath      String?

  headOfDepartment String? // User ID

  contactEmail String?
  contactPhone String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: Restrict)
  childDepartments Department[] @relation("DepartmentHierarchy")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([tenantId])
  @@map("departments")
}

model OrganizationUser {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  designation String?
  department  String?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_users")
}

// ============================================================================
// SCHOOL & ACADEMIC STRUCTURE
// ============================================================================

enum Board {
  CBSE
  ICSE
  STATE_BOARD
  IB
  IGCSE
  NIOS
  OTHER
}

model School {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String?

  name      String
  code      String  @unique
  udiseCode String? @unique

  schoolType String? // PRIMARY, SECONDARY, HIGHER_SECONDARY, K12

  board             Board?
  affiliationNumber String?
  recognitionNumber String?

  principalId      String?
  vicePrincipalIds String[]

  // Address is now in Address table (entityType = "SCHOOL")
  // Geography linkage
  countryId  String?
  stateId    String?
  districtId String?
  blockId    String?

  coordinates Json? // {lat, lng}

  // Multi-tenancy
  tenantId      String  @unique
  hierarchyPath String?

  // Contact
  email   String?
  phone   String?
  website String?

  // Capacity
  totalCapacity   Int?
  currentStrength Int  @default(0)

  // Facilities
  facilities String[] // LIBRARY, LAB, PLAYGROUND, COMPUTER_LAB, etc.

  // Timing
  schoolTiming Json? // {startTime, endTime, workingDays}

  // Status
  isActive            Boolean @default(true)
  accreditationStatus String? // NAAC, CBSE, etc.
  accreditationGrade  String?

  establishedDate DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  academicYears    AcademicYear[]
  classes          Class[]
  students         StudentProfile[]
  teachers         TeacherProfile[]
  rooms            Room[]
  timeSlots        TimeSlot[]
  timetableEntries TimetableEntry[]
  attendance       Attendance[]
  fees             FeeStructure[]
  libraryBooks     LibraryBook[]
  transportRoutes  TransportRoute[]
  hostelBlocks     HostelBlock[]
  events           Event[]

  @@index([organizationId])
  @@index([branchId])
  @@index([code])
  @@index([tenantId])
  @@index([stateId])
  @@index([districtId])
  @@index([isActive])
  @@map("schools")
}

// ============================================================================
// ACADEMIC BOARDS & CURRICULUM (Normalized)
// ============================================================================

// Board as a table instead of enum for flexibility
model BoardMaster {
  id       String  @id @default(uuid())
  code     String  @unique // CBSE, ICSE, STATE_BOARD_MH, IB, etc.
  name     String
  fullName String?

  country   String  @default("IN")
  stateCode String? // For state boards

  website String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curricula Curriculum[]

  @@index([code])
  @@index([stateCode])
  @@map("board_masters")
}

// Curriculum for each board
model Curriculum {
  id      String @id @default(uuid())
  boardId String

  name String
  code String @unique

  gradeRange Json // {min: 1, max: 12}

  description String?

  isActive Boolean @default(true)

  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board BoardMaster @relation(fields: [boardId], references: [id], onDelete: Cascade)

  subjects CurriculumSubject[]

  @@index([boardId])
  @@index([code])
  @@map("curricula")
}

// Subject mapping to curriculum
model CurriculumSubject {
  id           String @id @default(uuid())
  curriculumId String
  subjectId    String

  grade Int

  isMandatory Boolean @default(true)
  isElective  Boolean @default(false)

  credits      Int?
  hoursPerWeek Int?

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, subjectId, grade])
  @@index([curriculumId])
  @@index([subjectId])
  @@map("curriculum_subjects")
}

model AcademicYear {
  id       String @id @default(uuid())
  schoolId String

  year      String // e.g., "2024-2025"
  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classes     Class[]
  enrollments StudentEnrollment[]

  @@unique([schoolId, year])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

// Grade level (not individual sections)
model Class {
  id             String @id @default(uuid())
  schoolId       String
  academicYearId String

  grade     Int // 1-12
  gradeName String? // "Grade 1", "Class X", etc.

  stream String? // SCIENCE, COMMERCE, ARTS (for 11-12)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  sections Section[]
  subjects ClassSubject[]

  @@unique([schoolId, academicYearId, grade, stream])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([schoolId, academicYearId])
  @@map("classes")
}

// Section within a class (actual student groups)
model Section {
  id      String @id @default(uuid())
  classId String

  sectionName String // A, B, C, etc.

  capacity        Int?
  currentStrength Int  @default(0)

  classTeacherId String?

  roomNumber String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  enrollments      StudentEnrollment[]
  timetableEntries TimetableEntry[]
  sectionSubjects  SectionSubject[]
  sectionTeachers  SectionTeacher[]
  assignments      Assignment[]
  exams            Exam[]

  @@unique([classId, sectionName])
  @@index([classId])
  @@index([classTeacherId])
  @@map("sections")
}

// Teachers assigned to sections
model SectionTeacher {
  id        String  @id @default(uuid())
  sectionId String
  teacherId String
  subjectId String?

  isPrimary Boolean @default(false) // Class teacher

  assignedAt DateTime @default(now())
  assignedBy String?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, teacherId, subjectId])
  @@index([sectionId])
  @@index([teacherId])
  @@map("section_teachers")
}

// Subjects for a specific section
model SectionSubject {
  id        String  @id @default(uuid())
  sectionId String
  subjectId String
  teacherId String?

  periodsPerWeek Int?

  isActive Boolean @default(true)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
  @@map("section_subjects")
}

model Subject {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?

  board Board?
  grade Int?

  isElective Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  classSubjects      ClassSubject[]
  curriculumSubjects CurriculumSubject[]
  sectionSubjects    SectionSubject[]
  chapters           Chapter[]

  @@index([board, grade])
  @@map("subjects")
}

model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?

  isActive Boolean @default(true)

  class   Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

// ============================================================================
// USER PROFILES
// ============================================================================

model StudentProfile {
  id       String  @id @default(uuid())
  userId   String  @unique
  schoolId String?

  rollNumber      String?
  admissionNumber String?   @unique
  admissionDate   DateTime?

  bloodGroup       String?
  emergencyContact Json?

  previousSchool String?
  transportOpted Boolean @default(false)
  hostelOpted    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  enrollments         StudentEnrollment[]
  parents             ParentStudent[]
  attendance          Attendance[]
  feeRecords          FeeRecord[]
  libraryIssues       LibraryIssue[]
  transportAssignment TransportStudentAssignment?
  hostelAssignment    HostelRoomAssignment?
  disciplinaryRecords DisciplinaryRecord[]

  learningProgress      LearningProgress[]
  examAttempts          ExamAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([userId])
  @@index([schoolId])
  @@map("student_profiles")
}

model TeacherProfile {
  id       String  @id @default(uuid())
  userId   String  @unique
  schoolId String?

  employeeId    String? @unique
  designation   String?
  qualification String?
  experience    Int? // years

  joiningDate DateTime?
  leavingDate DateTime?

  salary Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classSubjects ClassSubject[]
  assignments   Assignment[]
  exams         Exam[]
  liveClasses   LiveClass[]
  attendance    TeacherAttendance[]
  leaves        TeacherLeave[]

  @@index([userId])
  @@index([schoolId])
  @@map("teacher_profiles")
}

model ParentProfile {
  id     String @id @default(uuid())
  userId String @unique

  occupation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]

  @@index([userId])
  @@map("parent_profiles")
}

model ParentStudent {
  id        String @id @default(uuid())
  parentId  String
  studentId String

  relationship String // Father, Mother, Guardian
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

model PublisherProfile {
  id     String @id @default(uuid())
  userId String @unique

  companyName        String
  registrationNumber String? @unique
  taxId              String?

  website     String?
  description String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?

  bankDetails Json? // Encrypted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  books             Book[]
  arMarkers         ARMarker[]
  monetizationPlans PublisherMonetizationPlan[]

  @@index([userId])
  @@map("publisher_profiles")
}

model CreatorProfile {
  id     String @id @default(uuid())
  userId String @unique

  displayName String
  bio         String?
  expertise   String[]

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?

  bankDetails Json? // Encrypted

  totalEarnings Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contents          Content[]
  monetizationPlans CreatorMonetizationPlan[]

  @@index([userId])
  @@map("creator_profiles")
}

model StudentEnrollment {
  id             String @id @default(uuid())
  studentId      String
  sectionId      String // Now references Section
  academicYearId String

  enrollmentDate DateTime @default(now())
  status         String   @default("ACTIVE") // ACTIVE, TRANSFERRED, WITHDRAWN, COMPLETED

  rollNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([studentId, academicYearId, status])
  @@map("student_enrollments")
}

// ============================================================================
// CONTENT TAXONOMY & MANAGEMENT
// ============================================================================

enum ContentType {
  AR
  VR
  VIDEO
  PDF
  BOOK
  THREE_D_MODEL
  TWO_D_IMAGE
  GAME
  ANIMATION
  PPT
  DOCUMENT
  QUIZ
  SIMULATION
  AUDIO
  INTERACTIVE
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  EASY
  MEDIUM
  HARD
  ADVANCED
  EXPERT
}

model Chapter {
  id        String @id @default(uuid())
  subjectId String

  name          String
  code          String?
  chapterNumber Int?
  description   String?

  board Board?
  grade Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  topics Topic[]

  @@index([subjectId])
  @@index([board, grade])
  @@map("chapters")
}

model Topic {
  id        String @id @default(uuid())
  chapterId String

  name        String
  code        String?
  topicNumber Int?
  description String?

  estimatedDuration Int? // minutes

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  subtopics Subtopic[]
  contents  Content[]

  @@index([chapterId])
  @@map("topics")
}

model Subtopic {
  id      String @id @default(uuid())
  topicId String

  name        String
  code        String?
  description String?

  estimatedDuration Int? // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  subSubtopics SubSubtopic[]
  contents     Content[]

  @@index([topicId])
  @@map("subtopics")
}

model SubSubtopic {
  id         String @id @default(uuid())
  subtopicId String

  name        String
  code        String?
  description String?

  estimatedDuration Int? // minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  contents Content[]

  @@index([subtopicId])
  @@map("sub_subtopics")
}

model Content {
  id        String  @id @default(uuid())
  creatorId String?

  title       String
  description String?
  thumbnail   String?

  contentType ContentType
  status      ContentStatus @default(DRAFT)

  board         Board?
  grade         Int?
  subjectId     String?
  chapterId     String?
  topicId       String?
  subtopicId    String?
  subSubtopicId String?

  fileUrl      String? // S3 URL
  fileSize     Int? // bytes
  fileMimeType String?

  duration Int? // seconds for video/audio

  difficultyLevel DifficultyLevel?
  language        String           @default("en")

  tags             String[]
  keywords         String[]
  learningOutcomes String[]

  viewCount   Int      @default(0)
  rating      Decimal? @db.Decimal(3, 2)
  ratingCount Int      @default(0)

  isFree Boolean  @default(false)
  price  Decimal? @db.Decimal(10, 2)

  publishedAt DateTime?
  archivedAt  DateTime?

  versionNumber     String  @default("1.0")
  previousVersionId String?

  isLocked Boolean @default(false) // For version locking

  metadata Json? // Extra metadata

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  creator         CreatorProfile? @relation(fields: [creatorId], references: [id])
  previousVersion Content?        @relation("ContentVersions", fields: [previousVersionId], references: [id])
  versions        Content[]       @relation("ContentVersions")

  topic       Topic?       @relation(fields: [topicId], references: [id])
  subtopic    Subtopic?    @relation(fields: [subtopicId], references: [id])
  subSubtopic SubSubtopic? @relation(fields: [subSubtopicId], references: [id])

  arAssets ARContent[]
  vrAssets VRContent[]

  subscriptionAccess SubscriptionContent[]
  learningProgress   LearningProgress[]
  contentReviews     ContentReview[]

  @@index([creatorId])
  @@index([status])
  @@index([contentType])
  @@index([board, grade])
  @@index([subjectId])
  @@index([topicId])
  @@index([status, contentType]) // Composite for filtering
  @@index([board, grade, subjectId]) // Composite for curriculum
  @@index([creatorId, status]) // Composite for creator dashboard
  @@index([title, description, keywords]) // Replace fulltext with regular index
  @@map("contents")
}

model ContentReview {
  id        String @id @default(uuid())
  contentId String
  userId    String

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([contentId])
  @@map("content_reviews")
}

// ============================================================================
// CONTENT VERSIONING & WORKFLOW
// ============================================================================

enum WorkflowStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

// Content versions (full history)
model ContentVersion {
  id        String @id @default(uuid())
  contentId String

  versionNumber String // e.g., "1.0", "1.1", "2.0"
  versionType   String // MAJOR, MINOR, PATCH

  // Snapshot of content at this version
  title       String
  description String?
  thumbnail   String?

  fileUrl      String?
  fileSize     Int?
  fileMimeType String?

  metadata Json // Full content metadata snapshot

  status WorkflowStatus

  changedBy   String
  changeNotes String? // What changed in this version

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([versionNumber])
  @@index([status])
  @@map("content_versions")
}

// Content drafts (working copies)
model ContentDraft {
  id        String  @id @default(uuid())
  contentId String? // NULL for new content

  createdBy String

  // Draft data
  title       String
  description String?
  thumbnail   String?

  contentType ContentType

  fileUrl  String?
  metadata Json?

  // Auto-save
  lastSavedAt DateTime @default(now())

  // Draft status
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([createdBy])
  @@map("content_drafts")
}

// Content workflow (approval process)
model ContentWorkflow {
  id        String @id @default(uuid())
  contentId String

  status WorkflowStatus

  submittedBy String
  submittedAt DateTime @default(now())

  assignedTo String? // Reviewer
  assignedAt DateTime?

  reviewedBy String?
  reviewedAt DateTime?

  approvedBy String?
  approvedAt DateTime?

  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  publishedBy String?
  publishedAt DateTime?

  comments Json? // Array of workflow comments

  currentStep String? // SUBMISSION, REVIEW, APPROVAL, PUBLICATION

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([status])
  @@index([assignedTo])
  @@map("content_workflows")
}

// ============================================================================
// AR/VR SPECIFIC CONTENT
// ============================================================================

model Book {
  id          String @id @default(uuid())
  publisherId String

  title   String
  isbn    String? @unique
  edition String?

  board   Board?
  grade   Int?
  subject String?

  coverImage  String?
  description String?

  totalPages Int?

  publishedDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  publisher PublisherProfile @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  diagrams Diagram[]

  @@index([publisherId])
  @@index([board, grade])
  @@map("books")
}

model Diagram {
  id     String @id @default(uuid())
  bookId String

  title       String?
  imageUrl    String
  pageNumber  Int?
  chapterName String?

  resolution String? // e.g., "1920x1080"
  fileSize   Int? // bytes

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  arMarker ARMarker?

  @@index([bookId])
  @@map("diagrams")
}

model ARMarker {
  id          String  @id @default(uuid())
  publisherId String
  diagramId   String? @unique

  markerCode  String @unique // Globally unique marker ID
  markerImage String // Marker pattern image

  title       String?
  description String?

  isActive Boolean @default(true)

  metadata Json? // Detection config, thresholds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publisher PublisherProfile @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  diagram   Diagram?         @relation(fields: [diagramId], references: [id])

  arContents ARContent[]

  @@index([publisherId])
  @@index([markerCode])
  @@map("ar_markers")
}

model ARContent {
  id        String  @id @default(uuid())
  contentId String
  markerId  String?

  assetType String // 3D, Video, Animation, Audio
  assetUrl  String // S3 URL

  thumbnailUrl String?

  fileSize Int? // bytes
  format   String? // gltf, fbx, mp4, etc.

  optimized        Boolean @default(false)
  compressionLevel String?

  lodLevels Json? // Level of Detail models

  targetLevel String? // Beginner, Intermediate, Advanced

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  marker  ARMarker? @relation(fields: [markerId], references: [id])

  @@index([contentId])
  @@index([markerId])
  @@map("ar_contents")
}

model VRContent {
  id        String @id @default(uuid())
  contentId String

  experimentName String?
  assetType      String // VR_LAB, VR_SIMULATION, VR_360_VIDEO
  assetUrl       String // S3 URL

  thumbnailUrl String?

  fileSize Int? // bytes
  format   String?

  optimized Boolean @default(false)

  supportedHeadsets String[] // Quest2, Quest3, Pico, WebXR

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  vrLogs VRUsageLog[]

  @@index([contentId])
  @@map("vr_contents")
}

model VRUsageLog {
  id          String @id @default(uuid())
  vrContentId String
  userId      String

  sessionId   String
  headsetType String?

  startTime DateTime
  endTime   DateTime?
  duration  Int? // seconds

  interactions   Json? // Detailed interaction data
  completionRate Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  vrContent VRContent @relation(fields: [vrContentId], references: [id], onDelete: Cascade)

  @@index([vrContentId])
  @@index([userId])
  @@index([sessionId])
  @@map("vr_usage_logs")
}

// ============================================================================
// SUBSCRIPTION & LICENSING
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

enum SubscriptionTier {
  FREE
  AR_ONLY
  VR_ONLY
  AR_VR_BUNDLE
  LMS_ONLY
  COMPETITIVE_EXAM
  FULL_ACCESS
  CUSTOM
}

model Subscription {
  id             String  @id @default(uuid())
  organizationId String?
  userId         String?

  tier   SubscriptionTier
  status SubscriptionStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime

  gracePeriodDays Int @default(7)

  autoRenew Boolean @default(false)

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  billingCycle String // MONTHLY, QUARTERLY, ANNUAL, CUSTOM

  metadata Json? // Custom config

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  deletedAt   DateTime? // Soft delete

  organization Organization? @relation(fields: [organizationId], references: [id])

  contentAccess SubscriptionContent[]
  payments      Payment[]

