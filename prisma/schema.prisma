enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  PDF
  SPREADSHEET
  PRESENTATION
  ARCHIVE
  OTHER
}

enum MediaCategory {
  PROFILE_PHOTO
  ASSIGNMENT
  SUBMISSION
  CERTIFICATE
  REPORT
  QUESTION_PAPER
  ANSWER_SHEET
  CONTENT
  ANNOUNCEMENT
