// ============================================================================
// PAYMENT & BILLING
// ============================================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  WALLET
  RAZORPAY
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH
  CHEQUE
}

model Payment {
  id             String  @id @default(uuid())
  subscriptionId String?
  userId         String?
  organizationId String?

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)

  gatewayTransactionId String? @unique
  gatewayResponse      Json?

  paidAt     DateTime?
  failedAt   DateTime?
  refundedAt DateTime?

  invoice Json? // Invoice details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  attempts PaymentAttempt[]
  refunds  PaymentRefund[]

  @@index([subscriptionId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status]) // Composite for user payments
  @@index([organizationId, status]) // Composite for org payments
  @@index([status, createdAt]) // Composite for payment reports
  @@map("payments")
}

// Payment attempts (for retries and tracking)
model PaymentAttempt {
  id        String @id @default(uuid())
  paymentId String

  attemptNumber Int

  amount Decimal @db.Decimal(10, 2)

  paymentGateway String // RAZORPAY, STRIPE, PAYPAL

  gatewayRequest  Json?
  gatewayResponse Json?

  status String // INITIATED, SUCCESS, FAILED, TIMEOUT

  errorCode    String?
  errorMessage String?

  attemptedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("payment_attempts")
}

// Payment refunds
model PaymentRefund {
  id        String @id @default(uuid())
  paymentId String

  refundAmount Decimal @db.Decimal(10, 2)
  refundReason String

  refundType String // FULL, PARTIAL

  status String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  gatewayRefundId String?
  gatewayResponse Json?

  requestedBy String
  requestedAt DateTime @default(now())

  processedAt DateTime?
  completedAt DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("payment_refunds")
}

// Payment reconciliation (for accounting)
model PaymentReconciliation {
  id String @id @default(uuid())

  reconciliationDate DateTime @db.Date

  gateway String

  totalPayments Int     @default(0)
  totalAmount   Decimal @db.Decimal(12, 2)

  successfulPayments Int     @default(0)
  successfulAmount   Decimal @db.Decimal(12, 2)

  failedPayments   Int     @default(0)
  refundedPayments Int     @default(0)
  refundedAmount   Decimal @db.Decimal(12, 2)

  discrepancies Json? // Array of discrepancy details

  status String @default("PENDING") // PENDING, MATCHED, DISCREPANCY, RESOLVED

  reconciledBy String?
  reconciledAt DateTime?

  gatewayReport String? // Report file URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reconciliationDate])
  @@index([gateway])
  @@index([status])
  @@map("payment_reconciliations")
}

// Payment gateway logs (for debugging)
model PaymentGatewayLog {
  id String @id @default(uuid())

  gateway String

  endpoint   String
  httpMethod String

  requestHeaders Json?
  requestBody    Json?

  responseStatus  Int?
  responseHeaders Json?
  responseBody    Json?

  duration Int? // milliseconds

  timestamp DateTime @default(now())

  @@index([gateway])
  @@index([timestamp])
  @@map("payment_gateway_logs")
}

