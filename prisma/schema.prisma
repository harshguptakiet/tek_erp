// ============================================================================
// TRANSPORT MANAGEMENT (Enhanced with GPS/RFID)
// ============================================================================

model TransportRoute {
  id       String @id @default(uuid())
  schoolId String

  routeName   String
  routeNumber String

  startPoint String
  endPoint   String

  totalDistance Decimal? @db.Decimal(8, 2) // km
  estimatedTime Int? // minutes

  pickupTime String? // HH:MM
  dropTime   String? // HH:MM

  vehicleId   String?
  driverId    String?
  attendantId String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle TransportVehicle? @relation(fields: [vehicleId], references: [id])

  stops       TransportRouteStop[]
  assignments TransportStudentAssignment[]
  trips       TransportTrip[]

  @@index([schoolId])
  @@index([vehicleId])
  @@map("transport_routes")
}

model TransportRouteStop {
  id      String @id @default(uuid())
  routeId String

  stopName     String
  stopSequence Int

  address  String?
  landmark String?

  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  pickupTime String? // HH:MM
  dropTime   String? // HH:MM

  fare Decimal? @db.Decimal(8, 2)

  isActive Boolean @default(true)

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopSequence])
  @@index([routeId])
  @@map("transport_route_stops")
}

model TransportVehicle {
  id             String  @id @default(uuid())
  schoolId       String?
  organizationId String?

  vehicleNumber String @unique
  vehicleType   String // BUS, VAN, CAR

  make  String?
  model String?
  year  Int?

  capacity Int

  registrationNumber String?   @unique
  insuranceNumber    String?
  insuranceExpiry    DateTime? @db.Date

  fitnessExpiry   DateTime? @db.Date
  pollutionExpiry DateTime? @db.Date

  // GPS Device
  gpsDeviceId   String? @unique
  gpsDeviceIMEI String? @unique
  gpsProvider   String? // Provider name

  // RFID Reader
  rfidReaderId     String? @unique
  rfidReaderSerial String?

  // Tracking
  lastKnownLat  Decimal?  @db.Decimal(10, 8)
  lastKnownLng  Decimal?  @db.Decimal(11, 8)
  lastTrackedAt DateTime?

  currentSpeed Decimal? @db.Decimal(5, 2) // km/h
  fuelLevel    Decimal? @db.Decimal(5, 2) // percentage

  status String @default("IDLE") // IDLE, IN_TRANSIT, MAINTENANCE, OUT_OF_SERVICE

  maintenanceSchedule Json?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  routes             TransportRoute[]
  gpsLogs            VehicleGPSLog[]
  maintenanceRecords VehicleMaintenance[]
  trips              TransportTrip[]

  @@index([schoolId])
  @@index([organizationId])
  @@index([vehicleNumber])
  @@index([gpsDeviceId])
  @@index([status])
  @@map("transport_vehicles")
}

// GPS tracking logs for vehicles
// NOTE: Extremely high-volume table (logs every 10-30 seconds per vehicle)
// CRITICAL: Requires time-series database (TimescaleDB extension) or separate storage
// Partition by timestamp (daily partitions), auto-archive after 90 days
model VehicleGPSLog {
  id        String @id @default(uuid())
  vehicleId String

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)

  speed   Decimal? @db.Decimal(5, 2) // km/h
  heading Decimal? @db.Decimal(5, 2) // degrees

  altitude Decimal? @db.Decimal(8, 2) // meters
  accuracy Decimal? @db.Decimal(6, 2) // meters

  ignitionOn Boolean?
  fuelLevel  Decimal? @db.Decimal(5, 2)

  timestamp DateTime @default(now())

  vehicle TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, timestamp])
  @@index([timestamp])
  @@index([vehicleId]) // For vehicle-specific queries
  @@map("vehicle_gps_logs")
}

model VehicleMaintenance {
  id        String @id @default(uuid())
  vehicleId String

  maintenanceType String // REGULAR_SERVICE, REPAIR, INSPECTION, BREAKDOWN

  description String
  cost        Decimal @db.Decimal(10, 2)

  serviceDate     DateTime  @db.Date
  nextServiceDate DateTime? @db.Date

  serviceProvider String?
  invoiceNumber   String?

  odometer Int? // km reading

  status String @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED

  vehicle TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([serviceDate])
  @@map("vehicle_maintenance")
}

model TransportStudentAssignment {
  id        String  @id @default(uuid())
  studentId String  @unique
  routeId   String
  stopId    String?

  rfidCardNumber String?   @unique
  rfidCardIssued DateTime?

  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  status String @default("ACTIVE") // ACTIVE, SUSPENDED, DISCONTINUED

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  attendanceRecords TransportAttendance[]

  @@index([routeId])
  @@index([rfidCardNumber])
  @@map("transport_student_assignments")
}

model TransportAttendance {
  id           String  @id @default(uuid())
  assignmentId String
  tripId       String?

  date DateTime @db.Date

  tripType String // PICKUP, DROP

  boardedAt       DateTime?
  boardedLocation Json? // GPS coordinates

  alightedAt       DateTime?
  alightedLocation Json? // GPS coordinates

  status String // BOARDED, NOT_BOARDED, ABSENT

  // RFID tracking
  rfidScanIn  DateTime?
  rfidScanOut DateTime?

  // Verification
  verifiedBy String? // Driver/Attendant ID

  parentNotified Boolean   @default(false)
  notifiedAt     DateTime?

  assignment TransportStudentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  trip       TransportTrip?             @relation(fields: [tripId], references: [id])

  @@index([assignmentId])
  @@index([tripId])
  @@index([date])
  @@index([assignmentId, date]) // Composite for student attendance
  @@index([date, status]) // Composite for daily reports
  @@map("transport_attendance")
}

model TransportTrip {
  id        String @id @default(uuid())
  routeId   String
  vehicleId String

  date     DateTime @db.Date
  tripType String // PICKUP, DROP

  driverId    String
  attendantId String?

  plannedStartTime String // HH:MM
  plannedEndTime   String // HH:MM

  actualStartTime DateTime?
  actualEndTime   DateTime?

  startOdometer Int?
  endOdometer   Int?
  distance      Decimal? @db.Decimal(8, 2)

  status String @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED

  incidents Json? // Array of incident reports

  route   TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  attendance TransportAttendance[]

  @@index([routeId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@index([routeId, date]) // Composite for route trips
  @@index([vehicleId, date]) // Composite for vehicle trips
  @@index([date, status]) // Composite for daily trip reports
  @@map("transport_trips")
}

