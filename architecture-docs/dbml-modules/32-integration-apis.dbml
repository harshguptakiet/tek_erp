Enum IntegrationType {
  PAYMENT_GATEWAY
  SMS_PROVIDER
  EMAIL_PROVIDER
  VIDEO_CONFERENCE
  CLOUD_STORAGE
  ANALYTICS
  SSO
  LMS
  ERP
  GOVERNMENT_API
  CUSTOM
}

Table integrations [headercolor: #7F8C8D] {
  id String [pk]
  organizationId String
  integrationType IntegrationType [not null]
  providerName String [not null]
  config Json [not null]
  isActive Boolean [not null, default: true]
  isTest Boolean [not null, default: false]
  lastSyncAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table oauth_tokens [headercolor: #7F8C8D] {
  id String [pk]
  userId String [not null]
  provider String [not null]
  accessToken String [not null]
  refreshToken String
  tokenType String
  expiresAt DateTime
  scope String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table external_mappings [headercolor: #7F8C8D] {
  id String [pk]
  internalEntityType String [not null]
  internalEntityId String [not null]
  externalSystem String [not null]
  externalId String [not null]
  mappingData Json
  isActive Boolean [not null, default: true]
  lastSyncedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (internalEntityType, internalEntityId, externalSystem) [unique]
  }
}

Table sync_history [headercolor: #7F8C8D] {
  id String [pk]
  integrationId String [not null]
  externalSystem String [not null]
  syncType String [not null]
  entityType String [not null]
  recordsProcessed Int [not null, default: 0]
  recordsSuccess Int [not null, default: 0]
  recordsFailed Int [not null, default: 0]
  status String [not null, default: 'PENDING']
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  error String
  metadata Json
}

Table sync_failures [headercolor: #7F8C8D] {
  id String [pk]
  syncHistoryId String [not null]
  entityType String [not null]
  entityId String
  errorMessage String [not null]
  errorDetails Json
  retryCount Int [not null, default: 0]
  maxRetries Int [not null, default: 3]
  nextRetryAt DateTime
  isResolved Boolean [not null, default: false]
  resolvedAt DateTime
  createdAt DateTime [default: `now()`, not null]
}

Table sync_logs [headercolor: #7F8C8D] {
  id String [pk]
  organizationId String [not null]
  syncType String [not null]
  dataType String [not null]
  recordCount Int [not null, default: 0]
  status String [not null]
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  error String
  metadata Json
}

Table webhooks [headercolor: #7F8C8D] {
  id String [pk]
  organizationId String [not null]
  url String [not null]
  events String[] [not null]
  secret String
  isActive Boolean [not null, default: true]
  lastTriggeredAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deliveries webhook_deliveries [not null]
}

Table webhook_deliveries [headercolor: #7F8C8D] {
  id String [pk]
  webhookId String [not null]
  event String [not null]
  payload Json [not null]
  status String [not null]
  attempts Int [not null, default: 0]
  responseStatus Int
  responseBody String
  deliveredAt DateTime
  createdAt DateTime [default: `now()`, not null]
  webhook webhooks [not null]
}

