//// ======================================================
//// USER PROFILES & MANAGEMENT
//// Module: 03-user-management
//// Category: Foundation
//// Tables: 5
//// ======================================================

Table user_profiles [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  firstName String [not null]
  lastName String [not null]
  middleName String
  dateOfBirth DateTime
  gender String
  profileImage String
  coverImage String
  bio String
  about String
  bloodGroup String
  nationality String
  religion String
  category String
  fatherName String
  motherName String
  guardianName String
  languages String[] [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table user_contact_info [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  email String [unique]
  emailVerified Boolean [not null, default: false]
  emailVerifiedAt DateTime
  phone String [unique]
  phoneVerified Boolean [not null, default: false]
  phoneVerifiedAt DateTime
  alternateEmail String
  alternatePhone String
  whatsappNumber String
  emergencyContactName String
  emergencyContactPhone String
  emergencyContactRelation String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table user_verifications [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  emailVerified Boolean [not null, default: false]
  emailVerifiedAt DateTime
  phoneVerified Boolean [not null, default: false]
  phoneVerifiedAt DateTime
  aadhaarVerified Boolean [not null, default: false]
  aadhaarVerifiedAt DateTime
  documentVerified Boolean [not null, default: false]
  documentVerifiedAt DateTime
  documentsSubmitted Json
  verificationStatus String [not null, default: 'PENDING']
  verifiedBy String
  verificationNotes String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table user_preferences [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  language String [not null, default: 'en']
  timezone String [not null, default: 'Asia/Kolkata']
  dateFormat String [not null, default: 'DD/MM/YYYY']
  timeFormat String [not null, default: '24h']
  theme String [not null, default: 'light']
  notificationSettings Json
  privacySettings Json
  contentPreferences Json
  accessibility Json
  updatedAt DateTime [not null]
}

Table user_sensitive_data [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  aadhaarHash String [unique]
  aadhaarEncrypted String
  aadhaarMasked String
  panNumber String
  passportNumber String
  bankAccountEncrypted Json
  medicalConditions String[] [not null]
  allergies String[] [not null]
  encryptionKeyId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

