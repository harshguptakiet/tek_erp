Table ar_markers [headercolor: #E67E22] {
  id String [pk]
  publisherId String [not null]
  diagramId String [unique]
  markerCode String [unique, not null]
  markerImage String [not null]
  title String
  description String
  isActive Boolean [not null, default: true]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  publisher publisher_profiles [not null]
  diagram diagrams
  arContents ar_contents [not null]
}

Table ar_contents [headercolor: #E67E22] {
  id String [pk]
  contentId String [not null]
  markerId String
  assetType String [not null]
  assetUrl String [not null]
  thumbnailUrl String
  fileSize Int
  format String
  optimized Boolean [not null, default: false]
  compressionLevel String
  lodLevels Json
  targetLevel String
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  content contents [not null]
  marker ar_markers
}

Table vr_contents [headercolor: #E67E22] {
  id String [pk]
  contentId String [not null]
  experimentName String
  assetType String [not null]
  assetUrl String [not null]
  thumbnailUrl String
  fileSize Int
  format String
  optimized Boolean [not null, default: false]
  supportedHeadsets String[] [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  content contents [not null]
  vrLogs vr_usage_logs [not null]
}

Table vr_usage_logs [headercolor: #E67E22] {
  id String [pk]
  vrContentId String [not null]
  userId String [not null]
  sessionId String [not null]
  headsetType String
  startTime DateTime [not null]
  endTime DateTime
  duration Int
  interactions Json
  completionRate Decimal
  createdAt DateTime [default: `now()`, not null]
  vrContent vr_contents [not null]
}

Table three_d_models [headercolor: #E67E22] {
  id String [pk]
  title String [not null]
  description String
  modelUrl String [not null]
  thumbnailUrl String
  format String [not null]
  fileSize Int
  polyCount Int
  optimized Boolean [not null, default: false]
  lodLevels Json
  subjectId String
  topicId String
  tags String[] [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table metaverse_rooms [headercolor: #E67E22] {
  id String [pk]
  name String [not null]
  roomUrl String [not null]
  capacity Int [not null, default: 30]
  environmentConfig Json
  spatialAudioEnabled Boolean [not null, default: true]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

