//// ======================================================
//// AUDIT & LOGGING
//// Module: 31-audit-logging
//// Category: Infrastructure
//// Tables: 7
//// ======================================================

Table audit_logs [headercolor: #7F8C8D] {
  id String [pk]
  userId String
  tenantId String
  organizationId String
  schoolId String
  action String [not null]
  tableName String [not null]
  recordId String
  columnName String
  oldValue String
  newValue String
  resource String
  resourceId String
  changes Json
  ipAddress String
  userAgent String
  device String
  browser String
  os String
  location Json
  reason String
  metadata Json
  apiEndpoint String
  httpMethod String
  riskLevel String
  flagged Boolean [not null, default: false]
  timestamp DateTime [default: `now()`, not null]
  user users
}

Table activity_logs [headercolor: #7F8C8D] {
  id String [pk]
  userId String
  activityType String [not null]
  page String
  action String
  metadata Json
  ipAddress String
  userAgent String
  timestamp DateTime [default: `now()`, not null]
}

Table user_login_history [headercolor: #7F8C8D] {
  id String [pk]
  userId String [not null]
  loginAt DateTime [default: `now()`, not null]
  logoutAt DateTime
  ipAddress String
  userAgent String
  device String
  browser String
  os String
  location Json
  loginMethod String [not null, default: 'PASSWORD']
  success Boolean [not null, default: true]
  failureReason String
  sessionId String
}

Table session_analytics [headercolor: #7F8C8D] {
  id String [pk]
  userId String
  sessionId String [not null]
  startTime DateTime [default: `now()`, not null]
  endTime DateTime
  duration Int
  pagesViewed Int [not null, default: 0]
  actionsPerformed Int [not null, default: 0]
  device String
  browser String
  os String
  referrer String
}

Table error_logs [headercolor: #7F8C8D] {
  id String [pk]
  errorType String [not null]
  errorMessage String [not null]
  stackTrace String
  userId String
  requestPath String
  requestMethod String
  requestBody Json
  userAgent String
  ipAddress String
  resolved Boolean [not null, default: false]
  resolvedAt DateTime
  resolvedBy String
  timestamp DateTime [default: `now()`, not null]
}

Table usage_logs [headercolor: #7F8C8D] {
  id String [pk]
  userId String [not null]
  sessionId String [not null]
  activityType String [not null]
  resourceType String
  resourceId String
  deviceInfo Json
  ipAddress String
  duration Int
  metadata Json
  timestamp DateTime [default: `now()`, not null]
}

