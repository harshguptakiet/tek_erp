//// ======================================================
//// PAYMENTS & BILLING
//// Module: 17-payments-billing
//// Category: Finance
//// Tables: 7
//// ======================================================

Enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

Enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  WALLET
  RAZORPAY
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH
  CHEQUE
}

Table payments [headercolor: #F39C12] {
  id String [pk]
  subscriptionId String
  userId String
  organizationId String
  amount Decimal [not null]
  currency String [not null, default: 'INR']
  paymentMethod PaymentMethod [not null]
  status PaymentStatus [not null, default: 'PENDING']
  gatewayTransactionId String [unique]
  gatewayResponse Json
  paidAt DateTime
  failedAt DateTime
  refundedAt DateTime
  invoice Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  subscription subscriptions
  attempts payment_attempts [not null]
  refunds payment_refunds [not null]
}

Table payment_attempts [headercolor: #F39C12] {
  id String [pk]
  paymentId String [not null]
  attemptNumber Int [not null]
  amount Decimal [not null]
  paymentGateway String [not null]
  gatewayRequest Json
  gatewayResponse Json
  status String [not null]
  errorCode String
  errorMessage String
  attemptedAt DateTime [default: `now()`, not null]
  payment payments [not null]
}

Table payment_refunds [headercolor: #F39C12] {
  id String [pk]
  paymentId String [not null]
  refundAmount Decimal [not null]
  refundReason String [not null]
  refundType String [not null]
  status String [not null, default: 'PENDING']
  gatewayRefundId String
  gatewayResponse Json
  requestedBy String [not null]
  requestedAt DateTime [default: `now()`, not null]
  processedAt DateTime
  completedAt DateTime
  payment payments [not null]
}

Table payment_reconciliations [headercolor: #F39C12] {
  id String [pk]
  reconciliationDate DateTime [not null]
  gateway String [not null]
  totalPayments Int [not null, default: 0]
  totalAmount Decimal [not null]
  successfulPayments Int [not null, default: 0]
  successfulAmount Decimal [not null]
  failedPayments Int [not null, default: 0]
  refundedPayments Int [not null, default: 0]
  refundedAmount Decimal [not null]
  discrepancies Json
  status String [not null, default: 'PENDING']
  reconciledBy String
  reconciledAt DateTime
  gatewayReport String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table payment_gateway_logs [headercolor: #F39C12] {
  id String [pk]
  gateway String [not null]
  endpoint String [not null]
  httpMethod String [not null]
  requestHeaders Json
  requestBody Json
  responseStatus Int
  responseHeaders Json
  responseBody Json
  duration Int
  timestamp DateTime [default: `now()`, not null]
}

Table payouts [headercolor: #F39C12] {
  id String [pk]
  userId String [not null]
  amount Decimal [not null]
  currency String [not null, default: 'INR']
  status String [not null]
  payoutMethod String [not null]
  transactionId String
  initiatedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  metadata Json
}

Table payout_requests [headercolor: #F39C12] {
  id String [pk]
  userId String [not null]
  requestedAmount Decimal [not null]
  availableBalance Decimal [not null]
  status String [not null, default: 'PENDING']
  bankAccountDetails Json
  requestedAt DateTime [default: `now()`, not null]
  processedAt DateTime
  completedAt DateTime
  transactionId String
  rejectionReason String
}

