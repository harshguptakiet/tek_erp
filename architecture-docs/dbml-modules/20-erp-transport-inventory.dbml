  altitude Decimal
  accuracy Decimal
  ignitionOn Boolean
  fuelLevel Decimal
  timestamp DateTime [default: `now()`, not null]
  vehicle transport_vehicles [not null]
}

Table vehicle_maintenance [headercolor: #16A085] {
  id String [pk]
