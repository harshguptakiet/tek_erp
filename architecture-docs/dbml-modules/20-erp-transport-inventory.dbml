Table transport_routes [headercolor: #16A085] {
  id String [pk]
  schoolId String [not null]
  routeName String [not null]
  routeNumber String [not null]
  startPoint String [not null]
  endPoint String [not null]
  totalDistance Decimal
  estimatedTime Int
  pickupTime String
  dropTime String
  vehicleId String
  driverId String
  attendantId String
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  school schools [not null]
  vehicle transport_vehicles
  stops transport_route_stops [not null]
  assignments transport_student_assignments [not null]
  trips transport_trips [not null]
}

Table transport_route_stops [headercolor: #16A085] {
  id String [pk]
  routeId String [not null]
  stopName String [not null]
  stopSequence Int [not null]
  address String
  landmark String
  latitude Decimal
  longitude Decimal
  pickupTime String
  dropTime String
  fare Decimal
  isActive Boolean [not null, default: true]
  route transport_routes [not null]

  indexes {
    (routeId, stopSequence) [unique]
  }
}

Table transport_vehicles [headercolor: #16A085] {
  id String [pk]
  schoolId String
  organizationId String
  vehicleNumber String [unique, not null]
  vehicleType String [not null]
  make String
  model String
  year Int
  capacity Int [not null]
  registrationNumber String [unique]
  insuranceNumber String
  insuranceExpiry DateTime
  fitnessExpiry DateTime
  pollutionExpiry DateTime
  gpsDeviceId String [unique]
  gpsDeviceIMEI String [unique]
  gpsProvider String
  rfidReaderId String [unique]
  rfidReaderSerial String
  lastKnownLat Decimal
  lastKnownLng Decimal
  lastTrackedAt DateTime
  currentSpeed Decimal
  fuelLevel Decimal
  status String [not null, default: 'IDLE']
  maintenanceSchedule Json
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  routes transport_routes [not null]
  gpsLogs vehicle_gps_logs [not null]
  maintenanceRecords vehicle_maintenance [not null]
  trips transport_trips [not null]
}

Table vehicle_gps_logs [headercolor: #16A085] {
  id String [pk]
