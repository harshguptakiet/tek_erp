//// ======================================================
//// STUDENTS & TEACHERS
//// Module: 08-student-teacher
//// Category: Academic Core
//// Tables: 11
//// ======================================================

Table student_profiles [headercolor: #50C878] {
  id String [pk]
  userId String [unique, not null]
  schoolId String
  rollNumber String
  admissionNumber String [unique]
  admissionDate DateTime
  bloodGroup String
  emergencyContact Json
  previousSchool String
  transportOpted Boolean [not null, default: false]
  hostelOpted Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  user users [not null]
  school schools
  enrollments student_enrollments [not null]
  parents parent_students [not null]
  attendance attendance [not null]
  feeRecords fee_records [not null]
  libraryIssues library_issues [not null]
  transportAssignment transport_student_assignments
  hostelAssignment hostel_room_assignments
  disciplinaryRecords disciplinary_records [not null]
  learningProgress learning_progress [not null]
  examAttempts exam_attempts [not null]
  assignmentSubmissions assignment_submissions [not null]
}

Table teacher_profiles [headercolor: #50C878] {
  id String [pk]
  userId String [unique, not null]
  schoolId String
  employeeId String [unique]
  designation String
  qualification String
  experience Int
  joiningDate DateTime
  leavingDate DateTime
  salary Decimal
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  user users [not null]
  school schools
  classSubjects class_subjects [not null]
  assignments assignments [not null]
  exams exams [not null]
  liveClasses live_classes [not null]
  attendance teacher_attendance [not null]
  leaves teacher_leaves [not null]
}

Table parent_profiles [headercolor: #50C878] {
  id String [pk]
  userId String [unique, not null]
  occupation String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  user users [not null]
  children parent_students [not null]
}

Table publisher_profiles [headercolor: #50C878] {
  id String [pk]
  userId String [unique, not null]
  companyName String [not null]
  registrationNumber String [unique]
  taxId String
  website String
  description String
  isVerified Boolean [not null, default: false]
  verifiedAt DateTime
  termsAccepted Boolean [not null, default: false]
  termsAcceptedAt DateTime
  bankDetails Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  user users [not null]
  books books [not null]
  arMarkers ar_markers [not null]
  monetizationPlans publisher_monetization_plans [not null]
}

Table creator_profiles [headercolor: #50C878] {
  id String [pk]
  userId String [unique, not null]
  displayName String [not null]
  bio String
  expertise String[] [not null]
  isVerified Boolean [not null, default: false]
  verifiedAt DateTime
  termsAccepted Boolean [not null, default: false]
  termsAcceptedAt DateTime
  bankDetails Json
  totalEarnings Decimal [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  user users [not null]
  contents contents [not null]
  monetizationPlans creator_monetization_plans [not null]
}

Table student_enrollments [headercolor: #50C878] {
  id String [pk]
  studentId String [not null]
  sectionId String [not null]
  academicYearId String [not null]
  enrollmentDate DateTime [default: `now()`, not null]
  status String [not null, default: 'ACTIVE']
  rollNumber String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  student student_profiles [not null]
  section sections [not null]
  academicYear academic_years [not null]

  indexes {
    (studentId, academicYearId) [unique]
  }
}

Table class_subjects [headercolor: #50C878] {
  id String [pk]
  classId String [not null]
  subjectId String [not null]
  teacherId String
  isActive Boolean [not null, default: true]
  class classes [not null]
  subject subjects [not null]
  teacher teacher_profiles

  indexes {
    (classId, subjectId) [unique]
  }
}

Table section_teachers [headercolor: #50C878] {
  id String [pk]
  sectionId String [not null]
  teacherId String [not null]
  subjectId String
  isPrimary Boolean [not null, default: false]
  assignedAt DateTime [default: `now()`, not null]
  assignedBy String
  section sections [not null]

  indexes {
    (sectionId, teacherId, subjectId) [unique]
  }
}

Table section_subjects [headercolor: #50C878] {
  id String [pk]
  sectionId String [not null]
  subjectId String [not null]
  teacherId String
  periodsPerWeek Int
  isActive Boolean [not null, default: true]
  section sections [not null]
  subject subjects [not null]

  indexes {
    (sectionId, subjectId) [unique]
  }
}

Table parent_students [headercolor: #50C878] {
  id String [pk]
  parentId String [not null]
  studentId String [not null]
  relationship String [not null]
  isPrimary Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  parent parent_profiles [not null]
  student student_profiles [not null]

  indexes {
    (parentId, studentId) [unique]
  }
}

Table student_groups [headercolor: #50C878] {
  id String [pk]
  schoolId String [not null]
  groupName String [not null]
  groupType String [not null]
  color String
  motto String
  emblem String
  captainId String
  viceCaptainId String
  members String[] [not null]
  points Int [not null, default: 0]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

