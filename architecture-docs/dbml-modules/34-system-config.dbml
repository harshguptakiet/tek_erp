//// ======================================================
//// SYSTEM CONFIGURATION
//// Module: 34-system-config
//// Category: Infrastructure
//// Tables: 10
//// ======================================================

Table platform_settings [headercolor: #7F8C8D] {
  id String [pk]
  settingKey String [unique, not null]
  settingValue String [not null]
  valueType String [not null]
  category String
  description String
  isPublic Boolean [not null, default: false]
  isEncrypted Boolean [not null, default: false]
  updatedBy String
  updatedAt DateTime [not null]
}

Table organization_settings [headercolor: #7F8C8D] {
  id String [pk]
  organizationId String [not null]
  settingKey String [not null]
  settingValue String [not null]
  valueType String [not null]
  category String
  overridesPlatform Boolean [not null, default: false]
  updatedBy String
  updatedAt DateTime [not null]

  indexes {
    (organizationId, settingKey) [unique]
  }
}

Table school_settings [headercolor: #7F8C8D] {
  id String [pk]
  schoolId String [not null]
  settingKey String [not null]
  settingValue String [not null]
  valueType String [not null]
  category String
  updatedBy String
  updatedAt DateTime [not null]

  indexes {
    (schoolId, settingKey) [unique]
  }
}

Table user_settings [headercolor: #7F8C8D] {
  id String [pk]
  userId String [not null]
  settingKey String [not null]
  settingValue String [not null]
  valueType String [not null]
  category String
  updatedAt DateTime [not null]

  indexes {
    (userId, settingKey) [unique]
  }
}

Table feature_flags [headercolor: #7F8C8D] {
  id String [pk]
  flagName String [unique, not null]
  description String
  isEnabled Boolean [not null, default: false]
  enabledFor String[] [not null]
  rolloutPercent Decimal
  conditions Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  rollouts feature_rollouts [not null]
}

Table feature_rollouts [headercolor: #7F8C8D] {
  id String [pk]
  featureFlagId String [not null]
  rolloutStage String [not null]
  targetAudience String
  targetIds String[] [not null]
  rolloutPercent Decimal [not null, default: 0]
  startDate DateTime [not null]
  endDate DateTime
  status String [not null, default: 'SCHEDULED']
  metrics Json
  createdBy String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  featureFlag feature_flags [not null]
}

Table experiments [headercolor: #7F8C8D] {
  id String [pk]
  name String [unique, not null]
  description String
  hypothesis String
  experimentType String [not null]
  variants Json [not null]
  targetAudience Json
  sampleSize Int
  trafficAllocation Json
  startDate DateTime [not null]
  endDate DateTime
  status String [not null, default: 'DRAFT']
  winningVariant String
  results Json
  createdBy String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  abTests ab_tests [not null]
}

Table ab_tests [headercolor: #7F8C8D] {
  id String [pk]
  experimentId String [not null]
  userId String [not null]
  variant String [not null]
  assignedAt DateTime [default: `now()`, not null]
  converted Boolean [not null, default: false]
  convertedAt DateTime
  metrics Json
  experiment experiments [not null]

  indexes {
    (experimentId, userId) [unique]
  }
}

Table system_config [headercolor: #7F8C8D] {
  id String [pk]
  organizationId String [unique]
  logo String
  banner String
  favicon String
  primaryColor String
  secondaryColor String
  accentColor String
  companyName String
  tagline String
  customDomain String
  features Json
  smtpConfig Json
  smsConfig Json
  paymentGatewayConfig Json
  analyticsConfig Json
  maintenanceMode Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

