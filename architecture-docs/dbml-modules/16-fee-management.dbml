//// ======================================================
//// FEE MANAGEMENT
//// Module: 16-fee-management
//// Category: Finance
//// Tables: 10
//// ======================================================

Table fee_structures [headercolor: #F39C12] {
  id String [pk]
  schoolId String [not null]
  name String [not null]
  description String
  grade Int
  amount Decimal [not null]
  currency String [not null, default: 'INR']
  frequency String [not null]
  dueDate DateTime
  lateFeeAmount Decimal
  lateFeeDays Int
  isActive Boolean [not null, default: true]
  academicYear String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  school schools [not null]
  feeRecords fee_records [not null]
}

Table fee_records [headercolor: #F39C12] {
  id String [pk]
  studentId String [not null]
  feeStructureId String [not null]
  totalAmount Decimal [not null]
  paidAmount Decimal [not null, default: 0]
  balanceAmount Decimal [not null]
  discountAmount Decimal [not null, default: 0]
  discountReason String
  lateFeeAmount Decimal [not null, default: 0]
  status String [not null, default: 'PENDING']
  dueDate DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  student student_profiles [not null]
  feeStructure fee_structures [not null]
  payments fee_payments [not null]
}

Table fee_payments [headercolor: #F39C12] {
  id String [pk]
  feeRecordId String [not null]
  amount Decimal [not null]
  paymentMethod PaymentMethod [not null]
  paymentDate DateTime [not null]
  transactionId String
  receiptNumber String [unique]
  remarks String
  createdAt DateTime [default: `now()`, not null]
  feeRecord fee_records [not null]
}

Table fee_concessions [headercolor: #F39C12] {
  id String [pk]
  studentId String [not null]
  feeStructureId String
  concessionType String [not null]
  concessionAmount Decimal [not null]
  concessionPercent Decimal
  reason String
  approvedBy String [not null]
  approvedAt DateTime [default: `now()`, not null]
  effectiveFrom DateTime [not null]
  effectiveTo DateTime
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table fee_installments [headercolor: #F39C12] {
  id String [pk]
  feeRecordId String [not null]
  installmentNumber Int [not null]
  installmentAmount Decimal [not null]
  dueDate DateTime [not null]
  paidDate DateTime
  paidAmount Decimal [not null, default: 0]
