Ref: message_participants.conversationId > conversations.id [delete: Cascade]
Ref: messages.conversationId > conversations.id [delete: Cascade]
Ref: messages.replyToId - messages.id
Ref: message_attachments.messageId > messages.id [delete: Cascade]
Ref: message_read_receipts.messageId > messages.id [delete: Cascade]
Ref: message_reactions.messageId > messages.id [delete: Cascade]

