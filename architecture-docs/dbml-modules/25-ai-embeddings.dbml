Table content_embeddings [headercolor: #E74C3C] {
  id String [pk]
  contentId String [unique, not null]
  embeddingModel String [not null]
  embedding String [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table vector_embeddings [headercolor: #E74C3C] {
  id String [pk]
  indexId String [not null]
  entityType String [not null]
  entityId String [not null]
  embedding String [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  index vector_indexes [not null]

  indexes {
    (indexId, entityType, entityId) [unique]
  }
}

Table vector_indexes [headercolor: #E74C3C] {
  id String [pk]
  indexName String [unique, not null]
  indexType String [not null]
  dimension Int [not null]
  totalVectors Int [not null, default: 0]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  embeddings vector_embeddings [not null]
}

Table document_chunks [headercolor: #E74C3C] {
  id String [pk]
  documentId String [not null]
  documentType String [not null]
  chunkIndex Int [not null]
  chunkText String [not null]
  embeddingId String
  metadata Json
  createdAt DateTime [default: `now()`, not null]
}

Table retrieval_queries [headercolor: #E74C3C] {
  id String [pk]
  userId String [not null]
  query String [not null]
  retrievedChunks Json [not null]
  wasHelpful Boolean
  createdAt DateTime [default: `now()`, not null]
}

