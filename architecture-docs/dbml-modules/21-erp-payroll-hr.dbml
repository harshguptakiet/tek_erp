//// ======================================================
//// ERP: PAYROLL & HR
//// Module: 21-erp-payroll-hr
//// Category: ERP
//// Tables: 6
//// ======================================================

Table payroll_structures [headercolor: #16A085] {
  id String [pk]
  schoolId String
  organizationId String
  structureName String [not null]
  designation String
  basicSalary Decimal [not null]
  allowances Json [not null]
  deductions Json [not null]
  grossSalary Decimal [not null]
  netSalary Decimal [not null]
  effectiveFrom DateTime [not null]
  effectiveTo DateTime
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table employee_salaries [headercolor: #16A085] {
  id String [pk]
  employeeId String [not null]
  employeeType String [not null]
  payrollStructureId String
  monthYear String [not null]
  workingDays Int [not null]
  presentDays Int [not null]
  basicSalary Decimal [not null]
  allowances Json [not null]
  bonuses Json
  deductions Json [not null]
  penalties Json
  grossSalary Decimal [not null]
  netSalary Decimal [not null]
  status String [not null, default: 'DRAFT']
  approvedBy String
  approvedAt DateTime
  paidOn DateTime
  paymentMethod String
  transactionId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (employeeId, monthYear) [unique]
  }
}

Table payroll_advances [headercolor: #16A085] {
  id String [pk]
  employeeId String [not null]
  advanceAmount Decimal [not null]
  reason String [not null]
  requestedAt DateTime [default: `now()`, not null]
  approvedAt DateTime
  approvedBy String
  status String [not null, default: 'PENDING']
  disbursedAt DateTime
  disbursedAmount Decimal
  repaymentMode String
  installments Int
  installmentAmount Decimal
  balanceAmount Decimal [not null, default: 0]
}

Table leave_balances [headercolor: #16A085] {
  id String [pk]
  employeeId String [not null]
  employeeType String [not null]
  leaveType String [not null]
  totalLeaves Int [not null]
  usedLeaves Int [not null, default: 0]
  balanceLeaves Int [not null]
  year Int [not null]

  indexes {
    (employeeId, leaveType, year) [unique]
  }
}

