Ref: curricula.boardId > board_masters.id [delete: Cascade]
Ref: curriculum_subjects.curriculumId > curricula.id [delete: Cascade]
Ref: academic_years.schoolId > schools.id [delete: Cascade]
Ref: classes.schoolId > schools.id [delete: Cascade]
Ref: classes.academicYearId > academic_years.id [delete: Cascade]
Ref: sections.classId > classes.id [delete: Cascade]

