//// ======================================================
//// SCHOOL MANAGEMENT
//// Module: 06-school-structure
//// Category: Academic Core
//// Tables: 8
//// ======================================================

Enum Board {
  CBSE
  ICSE
  STATE_BOARD
  IB
  IGCSE
  NIOS
  OTHER
}

Table schools [headercolor: #50C878] {
  id String [pk]
  organizationId String [not null]
  branchId String
  name String [not null]
  code String [unique, not null]
  udiseCode String [unique]
  schoolType String
  board Board
  affiliationNumber String
  recognitionNumber String
  principalId String
  vicePrincipalIds String[] [not null]
  countryId String
  stateId String
  districtId String
  blockId String
  coordinates Json
  tenantId String [unique, not null]
  hierarchyPath String
  email String
  phone String
  website String
  totalCapacity Int
  currentStrength Int [not null, default: 0]
  facilities String[] [not null]
  schoolTiming Json
  isActive Boolean [not null, default: true]
  accreditationStatus String
  accreditationGrade String
  establishedDate DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  organization organizations [not null]
  branch branches
  academicYears academic_years [not null]
  classes classes [not null]
  students student_profiles [not null]
  teachers teacher_profiles [not null]
  rooms rooms [not null]
  timeSlots time_slots [not null]
  timetableEntries timetable_entries [not null]
  attendance attendance [not null]
  fees fee_structures [not null]
  libraryBooks library_books [not null]
  transportRoutes transport_routes [not null]
  hostelBlocks hostel_blocks [not null]
  events events [not null]
}

Table academic_years [headercolor: #50C878] {
  id String [pk]
  schoolId String [not null]
  year String [not null]
  startDate DateTime [not null]
  endDate DateTime [not null]
  isCurrent Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  school schools [not null]
  classes classes [not null]
  enrollments student_enrollments [not null]

  indexes {
    (schoolId, year) [unique]
  }
}

Table classes [headercolor: #50C878] {
  id String [pk]
  schoolId String [not null]
  academicYearId String [not null]
  grade Int [not null]
  gradeName String
  stream String
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  school schools [not null]
  academicYear academic_years [not null]
  sections sections [not null]
  subjects class_subjects [not null]

  indexes {
    (schoolId, academicYearId, grade, stream) [unique]
  }
}

Table sections [headercolor: #50C878] {
  id String [pk]
  classId String [not null]
  sectionName String [not null]
  capacity Int
  currentStrength Int [not null, default: 0]
  classTeacherId String
  roomNumber String
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  class classes [not null]
  enrollments student_enrollments [not null]
  timetableEntries timetable_entries [not null]
  sectionSubjects section_subjects [not null]
  sectionTeachers section_teachers [not null]
  assignments assignments [not null]
  exams exams [not null]

  indexes {
    (classId, sectionName) [unique]
  }
}

Table board_masters [headercolor: #50C878] {
  id String [pk]
  code String [unique, not null]
  name String [not null]
  fullName String
  country String [not null, default: 'IN']
  stateCode String
  website String
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  curricula curricula [not null]
}

Table curricula [headercolor: #50C878] {
  id String [pk]
  boardId String [not null]
  name String [not null]
  code String [unique, not null]
  gradeRange Json [not null]
  description String
  isActive Boolean [not null, default: true]
  effectiveFrom DateTime
  effectiveTo DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  board board_masters [not null]
  subjects curriculum_subjects [not null]
}

Table curriculum_subjects [headercolor: #50C878] {
  id String [pk]
  curriculumId String [not null]
  subjectId String [not null]
  grade Int [not null]
  isMandatory Boolean [not null, default: true]
  isElective Boolean [not null, default: false]
  credits Int
  hoursPerWeek Int
  curriculum curricula [not null]
  subject subjects [not null]

  indexes {
    (curriculumId, subjectId, grade) [unique]
  }
}

Table academic_calendar [headercolor: #50C878] {
  id String [pk]
  schoolId String [not null]
  academicYearId String [not null]
  eventName String [not null]
  eventType String [not null]
  startDate DateTime [not null]
  endDate DateTime
  description String
  isHoliday Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

