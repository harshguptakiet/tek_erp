//// RELATIONSHIPS (Internal to this module)
//// ======================================================

Ref: library_issues.bookId > library_books.id [delete: Cascade]
Ref: library_reservations.bookId > library_books.id [delete: Cascade]
Ref: hostel_rooms.blockId > hostel_blocks.id [delete: Cascade]
