Ref: contents.previousVersionId - contents.id
Ref: content_reviews.contentId > contents.id [delete: Cascade]
Ref: diagrams.bookId > books.id [delete: Cascade]
Ref: media_folders.parentId - media_folders.id
Ref: media.folderId > media_folders.id
Ref: media.previousVersionId - media.id
Ref: media_permissions.mediaId > media.id [delete: Cascade]

