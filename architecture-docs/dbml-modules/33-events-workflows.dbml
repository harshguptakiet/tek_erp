Enum EventType {
  USER_CREATED
  USER_UPDATED
  STUDENT_ENROLLED
  ASSIGNMENT_SUBMITTED
  EXAM_COMPLETED
  PAYMENT_RECEIVED
  FEE_OVERDUE
  ATTENDANCE_MARKED
  CONTENT_PUBLISHED
  NOTIFICATION_SENT
  INTEGRATION_SYNC
  CUSTOM
}

Table domain_events [headercolor: #7F8C8D] {
  id String [pk]
  eventType EventType [not null]
  eventName String [not null]
  aggregateType String [not null]
  aggregateId String [not null]
  payload Json [not null]
  userId String
  tenantId String
  organizationId String
  occurredAt DateTime [default: `now()`, not null]
  isProcessed Boolean [not null, default: false]
  processedAt DateTime
}

Table integration_events [headercolor: #7F8C8D] {
  id String [pk]
  eventType String [not null]
  targetSystem String [not null]
  payload Json [not null]
  status String [not null, default: 'PENDING']
  attempts Int [not null, default: 0]
  maxAttempts Int [not null, default: 3]
  lastAttemptAt DateTime
  sentAt DateTime
  error String
  createdAt DateTime [default: `now()`, not null]
}

Table event_subscriptions [headercolor: #7F8C8D] {
  id String [pk]
  subscriberName String [not null]
  eventType String [not null]
  endpoint String
  subscriptionType String [not null]
  filters Json
  isActive Boolean [not null, default: true]
  retryPolicy Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  retries event_retries [not null]
}

Table event_retries [headercolor: #7F8C8D] {
  id String [pk]
  subscriptionId String [not null]
  eventId String [not null]
  eventType String [not null]
  payload Json [not null]
  attemptNumber Int [not null, default: 1]
  maxAttempts Int [not null, default: 3]
  status String [not null, default: 'PENDING']
  lastError String
  nextRetryAt DateTime
  lastAttemptAt DateTime
  createdAt DateTime [default: `now()`, not null]
  subscription event_subscriptions [not null]
}

Table event_failures [headercolor: #7F8C8D] {
  id String [pk]
  eventId String [not null]
  eventType String [not null]
  subscriptionId String
  payload Json [not null]
  failureReason String [not null]
  errorDetails Json
  attempts Int [not null]
  failedAt DateTime [default: `now()`, not null]
  isResolved Boolean [not null, default: false]
  resolvedAt DateTime
