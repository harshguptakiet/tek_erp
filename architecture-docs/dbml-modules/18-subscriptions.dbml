//// ======================================================
//// SUBSCRIPTIONS & LICENSES
//// Module: 18-subscriptions
//// Category: Finance
//// Tables: 5
//// ======================================================

Enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

Table subscriptions [headercolor: #F39C12] {
  id String [pk]
  organizationId String
  userId String
  tier SubscriptionTier [not null]
  status SubscriptionStatus [not null, default: 'PENDING']
  startDate DateTime [not null]
  endDate DateTime [not null]
  gracePeriodDays Int [not null, default: 7]
  autoRenew Boolean [not null, default: false]
  price Decimal [not null]
  currency String [not null, default: 'INR']
  billingCycle String [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  cancelledAt DateTime
  deletedAt DateTime
  organization organizations
  contentAccess subscription_contents [not null]
  payments payments [not null]
}

Table subscription_contents [headercolor: #F39C12] {
  id String [pk]
  subscriptionId String [not null]
  contentId String [not null]
  grantedAt DateTime [default: `now()`, not null]
  subscription subscriptions [not null]
  content contents [not null]

  indexes {
    (subscriptionId, contentId) [unique]
  }
}

Table licenses [headercolor: #F39C12] {
  id String [pk]
  organizationId String [not null]
  licenseType String [not null]
  totalSeats Int [not null]
  usedSeats Int [not null, default: 0]
  startDate DateTime [not null]
  endDate DateTime [not null]
  isActive Boolean [not null, default: true]
  pricingModel String [not null]
  price Decimal [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organization organizations [not null]
  assignments license_assignments [not null]
}

Table license_assignments [headercolor: #F39C12] {
  id String [pk]
  licenseId String [not null]
  userId String [not null]
  assignedAt DateTime [default: `now()`, not null]
  assignedBy String
  revokedAt DateTime
  license licenses [not null]

  indexes {
    (licenseId, userId) [unique]
  }
}

Table content_purchases [headercolor: #F39C12] {
  id String [pk]
  contentId String [not null]
  userId String [not null]
  purchasePrice Decimal [not null]
  platformFee Decimal [not null]
  creatorEarnings Decimal [not null]
  purchasedAt DateTime [default: `now()`, not null]

  indexes {
    (contentId, userId) [unique]
  }
}

//// ======================================================
//// RELATIONSHIPS (Internal to this module)
//// ======================================================

Ref: license_assignments.licenseId > licenses.id [delete: Cascade]
Ref: subscription_contents.subscriptionId > subscriptions.id [delete: Cascade]

