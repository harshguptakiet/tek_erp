//// ======================================================
//// SUBJECTS & CURRICULUM
//// Module: 07-subjects-curriculum
//// Category: Academic Core
//// Tables: 9
//// ======================================================

Table subjects [headercolor: #50C878] {
  id String [pk]
  name String [not null]
  code String [unique, not null]
  description String
  board Board
  grade Int
  isElective Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  classSubjects class_subjects [not null]
  curriculumSubjects curriculum_subjects [not null]
  sectionSubjects section_subjects [not null]
  chapters chapters [not null]
}

Table chapters [headercolor: #50C878] {
  id String [pk]
  subjectId String [not null]
  name String [not null]
  code String
  chapterNumber Int
  description String
  board Board
  grade Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  subject subjects [not null]
  topics topics [not null]
}

Table topics [headercolor: #50C878] {
  id String [pk]
  chapterId String [not null]
  name String [not null]
  code String
  topicNumber Int
  description String
  estimatedDuration Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  chapter chapters [not null]
  subtopics subtopics [not null]
  contents contents [not null]
}

Table subtopics [headercolor: #50C878] {
  id String [pk]
  topicId String [not null]
  name String [not null]
  code String
  description String
  estimatedDuration Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  topic topics [not null]
  subSubtopics sub_subtopics [not null]
  contents contents [not null]
}

Table sub_subtopics [headercolor: #50C878] {
  id String [pk]
  subtopicId String [not null]
  name String [not null]
  code String
  description String
  estimatedDuration Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  subtopic subtopics [not null]
  contents contents [not null]
}

Table syllabus_versions [headercolor: #50C878] {
  id String [pk]
  curriculumId String [not null]
  version String [not null]
  versionName String
  effectiveFrom DateTime [not null]
  effectiveTo DateTime
  changes Json
  isActive Boolean [not null, default: true]
  approvedBy String
  approvedAt DateTime
  syllabus Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table learning_outcomes [headercolor: #50C878] {
  id String [pk]
  code String [unique, not null]
  description String [not null]
  curriculumId String
  subjectId String
  topicId String
  bloomsLevel String
  competencies String[] [not null]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table competencies [headercolor: #50C878] {
  id String [pk]
  code String [unique, not null]
  name String [not null]
  description String
  category String
  parentId String
  isActive Boolean [not null, default: true]
  parent competencies
  children competencies [not null]
}

Table syllabus_progress [headercolor: #50C878] {
  id String [pk]
  classId String [not null]
  subjectId String [not null]
  topicId String
  completedPercentage Decimal [not null, default: 0]
  lastTaughtDate DateTime
  updatedAt DateTime [not null]

  indexes {
    (classId, subjectId, topicId) [unique]
  }
}

//// ======================================================
//// RELATIONSHIPS (Internal to this module)
//// ======================================================

Ref: chapters.subjectId > subjects.id [delete: Cascade]
Ref: topics.chapterId > chapters.id [delete: Cascade]
Ref: subtopics.topicId > topics.id [delete: Cascade]
Ref: sub_subtopics.subtopicId > subtopics.id [delete: Cascade]
Ref: competencies.parentId - competencies.id

