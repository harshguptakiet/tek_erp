//// ======================================================
//// AUTHENTICATION CORE
//// Module: 01-authentication
//// Category: Foundation
//// Tables: 8
//// ======================================================

Enum SystemRole {
  PLATFORM_ADMIN
  GOVERNMENT
  ORG_OWNER
  ORG_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  PUBLISHER
  CREATOR
  GUEST
}

Enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  AADHAAR
  SCHOOL_ID
}

Enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

Table users [headercolor: #4A90E2] {
  id String [pk]
  email String [unique]
  phone String [unique]
  aadhaarLast4 String
  username String [unique]
  passwordHash String
  firstName String [not null]
  lastName String [not null]
  middleName String
  dateOfBirth DateTime
  gender String
  profileImage String
  role SystemRole [not null]
  status UserStatus [not null, default: 'PENDING_VERIFICATION']
  authProvider AuthProvider [not null, default: 'LOCAL']
  twoFactorEnabled Boolean [not null, default: false]
  twoFactorSecret String
  passwordExpiry DateTime
  lastPasswordChange DateTime
  emailVerified Boolean [not null, default: false]
  phoneVerified Boolean [not null, default: false]
  lastLogin DateTime
  failedLoginAttempts Int [not null, default: 0]
  lockedUntil DateTime
  tenantId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  userSessions user_sessions [not null]
  userRoles user_role_mappings [not null]
  userRolesNew user_roles [not null]
  customPermissions custom_permissions [not null]
  organizations organization_users [not null]
  studentProfile student_profiles
  teacherProfile teacher_profiles
  parentProfile parent_profiles
  publisherProfile publisher_profiles
  creatorProfile creator_profiles
  auditLogs audit_logs [not null]
  notifications notifications [not null]
  messages messages [not null]
}

Table user_sessions [headercolor: #4A90E2] {
  id String [pk]
  userId String [not null]
  token String [unique, not null]
  refreshToken String [unique]
  deviceInfo Json
  ipAddress String
  userAgent String
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  lastActivity DateTime [default: `now()`, not null]
  user users [not null]
}

Table user_authentications [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  passwordHash String
  passwordExpiry DateTime
  lastPasswordChange DateTime
  authProvider AuthProvider [not null, default: 'LOCAL']
  googleId String [unique]
  microsoftId String [unique]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table user_security [headercolor: #4A90E2] {
  id String [pk]
  userId String [unique, not null]
  twoFactorEnabled Boolean [not null, default: false]
  twoFactorSecret String
  failedLoginAttempts Int [not null, default: 0]
  lockedUntil DateTime
  passwordResetRequired Boolean [not null, default: false]
  securityQuestions Json
  trustedDevices String[] [not null]
  lastSecurityAudit DateTime
  updatedAt DateTime [not null]
}

Table password_reset_tokens [headercolor: #4A90E2] {
  id String [pk]
  userId String [not null]
  token String [unique, not null]
  expiresAt DateTime [not null]
  usedAt DateTime
  createdAt DateTime [default: `now()`, not null]
}

Table two_factor_backup_codes [headercolor: #4A90E2] {
  id String [pk]
  userId String [not null]
  code String [unique, not null]
  isUsed Boolean [not null, default: false]
  usedAt DateTime
  createdAt DateTime [default: `now()`, not null]
}

Table login_attempts [headercolor: #4A90E2] {
  id String [pk]
  email String
  phone String
  username String
  success Boolean [not null]
  ipAddress String
  userAgent String
  location Json
  failureReason String
  timestamp DateTime [default: `now()`, not null]
}

Table device_tokens [headercolor: #4A90E2] {
  id String [pk]
  userId String [not null]
  token String [unique, not null]
  deviceType String [not null]
  deviceId String
  deviceName String
  isActive Boolean [not null, default: true]
  lastUsedAt DateTime [default: `now()`, not null]
  createdAt DateTime [default: `now()`, not null]
}

