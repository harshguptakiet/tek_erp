//// ======================================================
//// BACKGROUND JOBS
//// Module: 36-background-jobs
//// Category: Infrastructure
//// Tables: 4
//// ======================================================

Table background_jobs [headercolor: #7F8C8D] {
  id String [pk]
  jobType String [not null]
  status String [not null, default: 'PENDING']
  payload Json
  result Json
  attempts Int [not null, default: 0]
  maxAttempts Int [not null, default: 3]
  priority Int [not null, default: 5]
  scheduledAt DateTime
  startedAt DateTime
  completedAt DateTime
  nextRetryAt DateTime
  lastError String
  errorHistory Json
  isDeadLetter Boolean [not null, default: false]
  deadLetterAt DateTime
  deadLetterReason String
  executionTime Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  executions job_executions [not null]
}

Table job_executions [headercolor: #7F8C8D] {
  id String [pk]
  jobId String [not null]
  attemptNumber Int [not null]
  status String [not null]
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  executionTime Int
  error String
  stackTrace String
  result Json
  job background_jobs [not null]
}

Table cache_entries [headercolor: #7F8C8D] {
  id String [pk]
  key String [unique, not null]
  value String [not null]
  ttl Int
  expiresAt DateTime
  tags String[] [not null]
  createdAt DateTime [default: `now()`, not null]
}

Table system_metrics [headercolor: #7F8C8D] {
  id String [pk]
  metricType String [not null]
  value Decimal [not null]
  unit String
  tags Json
  timestamp DateTime [default: `now()`, not null]
}

//// ======================================================
//// RELATIONSHIPS (Internal to this module)
//// ======================================================

Ref: job_executions.jobId > background_jobs.id [delete: Cascade]

