//// ======================================================
//// RBAC & PERMISSIONS
//// Module: 02-rbac-permissions
//// Category: Foundation
//// Tables: 11
//// ======================================================

Table roles [headercolor: #4A90E2] {
  id String [pk]
  name String [not null]
  displayName String [not null]
  description String
  organizationId String
  isSystemRole Boolean [not null, default: false]
  isActive Boolean [not null, default: true]
  priority Int [not null, default: 100]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  organization organizations
  permissions role_permissions [not null]
  userRoles user_roles [not null]
  childRoles role_inheritances [not null]
  parentRoles role_inheritances [not null]

  indexes {
    (name, organizationId) [unique]
  }
}

Table permissions [headercolor: #4A90E2] {
  id String [pk]
  name String [unique, not null]
  displayName String [not null]
  description String
  categoryId String
  groupId String
  resource String [not null]
  action String [not null]
  scope String [not null, default: 'ORGANIZATION']
  isSystemPermission Boolean [not null, default: false]
  isActive Boolean [not null, default: true]
  riskLevel String [not null, default: 'LOW']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  category permission_categories
  group permission_groups
  rolePermissions role_permissions [not null]
  dependencies permission_dependencies [not null]
  dependents permission_dependencies [not null]
}

Table role_permissions [headercolor: #4A90E2] {
  id String [pk]
  roleId String [not null]
  permissionId String [not null]
  conditions Json
  grantedAt DateTime [default: `now()`, not null]
  grantedBy String
  role roles [not null]
  permission permissions [not null]

  indexes {
    (roleId, permissionId) [unique]
  }
}

Table permission_categories [headercolor: #4A90E2] {
  id String [pk]
  name String [unique, not null]
  displayName String [not null]
  description String
  sortOrder Int [not null, default: 0]
  permissions permissions [not null]
}

Table permission_groups [headercolor: #4A90E2] {
  id String [pk]
  name String [unique, not null]
  displayName String [not null]
  description String
  categoryId String
  sortOrder Int [not null, default: 0]
  permissions permissions [not null]
}

Table permission_dependencies [headercolor: #4A90E2] {
  id String [pk]
  permissionId String [not null]
  requiredPermissionId String [not null]
  isStrict Boolean [not null, default: true]
  permission permissions [not null]
  requiredPermission permissions [not null]

  indexes {
    (permissionId, requiredPermissionId) [unique]
  }
}

Table role_inheritances [headercolor: #4A90E2] {
  id String [pk]
  parentRoleId String [not null]
  childRoleId String [not null]
  createdAt DateTime [default: `now()`, not null]
  parentRole roles [not null]
  childRole roles [not null]

  indexes {
    (parentRoleId, childRoleId) [unique]
  }
}

Table user_roles [headercolor: #4A90E2] {
  id String [pk]
  userId String [not null]
  roleId String [not null]
  scopeType String
  scopeId String
  assignedAt DateTime [default: `now()`, not null]
  assignedBy String
  expiresAt DateTime
  isActive Boolean [not null, default: true]
  user users [not null]
  role roles [not null]

  indexes {
    (userId, roleId, scopeType, scopeId) [unique]
  }
}

Table custom_roles [headercolor: #4A90E2] {
  id String [pk]
  name String [not null]
  description String
  organizationId String
  isSystemRole Boolean [not null, default: false]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  permissions custom_permissions [not null]
  users user_role_mappings [not null]
  organization organizations

  indexes {
    (name, organizationId) [unique]
  }
}

Table custom_permissions [headercolor: #4A90E2] {
  id String [pk]
  roleId String [not null]
  userId String
  resource String [not null]
  action String [not null]
  conditions Json
  createdAt DateTime [default: `now()`, not null]
  role custom_roles [not null]
  user users
}

Table user_role_mappings [headercolor: #4A90E2] {
  id String [pk]
  userId String [not null]
  roleId String [not null]
  organizationId String
  assignedAt DateTime [default: `now()`, not null]
  assignedBy String
  user users [not null]
  role custom_roles [not null]
  organization organizations

  indexes {
    (userId, roleId, organizationId) [unique]
  }
}

//// ======================================================
//// RELATIONSHIPS (Internal to this module)
//// ======================================================

Ref: custom_permissions.roleId > custom_roles.id [delete: Cascade]
Ref: user_role_mappings.roleId > custom_roles.id [delete: Cascade]
Ref: permissions.categoryId > permission_categories.id [delete: Set Null]
Ref: permissions.groupId > permission_groups.id [delete: Set Null]
Ref: role_permissions.roleId > roles.id [delete: Cascade]
Ref: role_permissions.permissionId > permissions.id [delete: Cascade]
Ref: permission_dependencies.permissionId > permissions.id [delete: Cascade]
Ref: permission_dependencies.requiredPermissionId > permissions.id [delete: Cascade]
Ref: role_inheritances.parentRoleId > roles.id [delete: Cascade]
Ref: role_inheritances.childRoleId > roles.id [delete: Cascade]
Ref: user_roles.roleId > roles.id [delete: Cascade]

