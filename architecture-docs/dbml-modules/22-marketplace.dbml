//// ======================================================
//// MARKETPLACE
//// Module: 22-marketplace
//// Category: Finance
//// Tables: 5
//// ======================================================

Table marketplace_products [headercolor: #F39C12] {
  id String [pk]
  contentId String
  publisherId String
  creatorId String
  productName String [not null]
  description String
  productType String [not null]
  price Decimal [not null]
  currency String [not null, default: 'INR']
  discountPercent Decimal
  discountedPrice Decimal
  isActive Boolean [not null, default: true]
  isFeatured Boolean [not null, default: false]
  salesCount Int [not null, default: 0]
  revenueGenerated Decimal [not null, default: 0]
  rating Decimal
  reviewCount Int [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  orders marketplace_orders [not null]
}

Table marketplace_orders [headercolor: #F39C12] {
  id String [pk]
  productId String [not null]
  buyerId String [not null]
  quantity Int [not null, default: 1]
  totalAmount Decimal [not null]
  platformFee Decimal [not null]
  sellerEarnings Decimal [not null]
  status String [not null, default: 'PENDING']
  paymentId String
  orderedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  product marketplace_products [not null]
}

Table content_recommendations [headercolor: #F39C12] {
  id String [pk]
  userId String [not null]
  contentId String [not null]
  recommendationType String [not null]
  score Decimal [not null]
  viewed Boolean [not null, default: false]
  clicked Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
}

Table creator_monetization_plans [headercolor: #F39C12] {
  id String [pk]
  creatorId String [not null]
  planType String [not null]
  maxUploads Int
  maxStorage Int
  platformCommissionPercent Decimal [not null]
  isActive Boolean [not null, default: true]
  startDate DateTime [default: `now()`, not null]
  endDate DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  creator creator_profiles [not null]
}

Table publisher_monetization_plans [headercolor: #F39C12] {
  id String [pk]
  publisherId String [not null]
  planType String [not null]
  maxUploads Int
  maxStorage Int
  platformCommissionPercent Decimal [not null]
  isActive Boolean [not null, default: true]
  startDate DateTime [default: `now()`, not null]
  endDate DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  publisher publisher_profiles [not null]
}

