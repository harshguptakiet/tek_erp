//// ======================================================
//// NOTIFICATIONS
//// Module: 26-notifications
//// Category: Platform Services
//// Tables: 6
//// ======================================================

Enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

Enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

Table notifications [headercolor: #E74C3C] {
  id String [pk]
  userId String [not null]
  title String [not null]
  message String [not null]
  type String [not null]
  channels NotificationChannel[] [not null]
  priority NotificationPriority [not null, default: 'MEDIUM']
  resourceType String
  resourceId String
  isRead Boolean [not null, default: false]
  readAt DateTime
  scheduledAt DateTime
  sentAt DateTime
  templateId String
  templateData Json
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  deletedAt DateTime
  user users [not null]
  deliveries notification_deliveries [not null]
}

Table notification_templates [headercolor: #E74C3C] {
  id String [pk]
  name String [not null]
  templateType String [not null]
  subject String
  body String [not null]
  variables String[] [not null]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table notification_preferences [headercolor: #E74C3C] {
  id String [pk]
  userId String [unique, not null]
  emailEnabled Boolean [not null, default: true]
  smsEnabled Boolean [not null, default: true]
  pushEnabled Boolean [not null, default: true]
  whatsappEnabled Boolean [not null, default: false]
  preferences Json
  updatedAt DateTime [not null]
}

Table notification_deliveries [headercolor: #E74C3C] {
  id String [pk]
  notificationId String [not null]
  channel String [not null]
  recipient String [not null]
  status String [not null, default: 'PENDING']
  attempts Int [not null, default: 0]
  sentAt DateTime
  deliveredAt DateTime
  openedAt DateTime
  clickedAt DateTime
  error String
  gatewayId String
  gatewayResponse Json
  notification notifications [not null]
}

Table sms_logs [headercolor: #E74C3C] {
  id String [pk]
  userId String
  phone String [not null]
  message String [not null]
  status String [not null]
  gateway String
  gatewayId String
  sentAt DateTime [default: `now()`, not null]
  deliveredAt DateTime
  cost Decimal
}

Table email_logs [headercolor: #E74C3C] {
  id String [pk]
  userId String
  email String [not null]
  subject String [not null]
  body String [not null]
  status String [not null]
  provider String
  providerId String
  sentAt DateTime [default: `now()`, not null]
  deliveredAt DateTime
  openedAt DateTime
}

