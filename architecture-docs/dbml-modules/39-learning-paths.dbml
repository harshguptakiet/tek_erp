//// ======================================================
//// LEARNING PATHS & PROGRESS
//// Module: 39-learning-paths
//// Category: Academic Core
//// Tables: 3
//// ======================================================

Table learning_paths [headercolor: #50C878] {
  id String [pk]
  name String [not null]
  description String
  board Board
  grade Int
  subjectId String
  steps Json [not null]
  estimatedDuration Int
  difficulty DifficultyLevel
  enrollmentCount Int [not null, default: 0]
  completionRate Decimal
  isPublic Boolean [not null, default: false]
  createdBy String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table learning_path_enrollments [headercolor: #50C878] {
  id String [pk]
  pathId String [not null]
  studentId String [not null]
  currentStep Int [not null, default: 0]
  completedSteps Int[] [not null]
  progressPercent Decimal [not null, default: 0]
  enrolledAt DateTime [default: `now()`, not null]
  completedAt DateTime

  indexes {
    (pathId, studentId) [unique]
  }
}

Table learning_progress [headercolor: #50C878] {
  id String [pk]
  studentId String [not null]
  contentId String [not null]
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  lastAccessedAt DateTime [default: `now()`, not null]
  timeSpent Int [not null, default: 0]
  progressPercent Decimal [not null, default: 0]
  interactionCount Int [not null, default: 0]
  masteryLevel String
  metadata Json
  student student_profiles [not null]
  content contents [not null]

  indexes {
    (studentId, contentId) [unique]
  }
}

