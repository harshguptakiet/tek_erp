//// ======================================================
//// SEARCH & DISCOVERY
//// Module: 29-search-discovery
//// Category: Platform Services
//// Tables: 8
//// ======================================================

Table search_indexes [headercolor: #E74C3C] {
  id String [pk]
  entityType String [not null]
  entityId String [not null]
  searchableText String [not null]
  title String
  description String
  metadata Json
  popularity Int [not null, default: 0]
  lastAccessedAt DateTime
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (entityType, entityId) [unique]
  }
}

Table search_keywords [headercolor: #E74C3C] {
  id String [pk]
  keyword String [unique, not null]
  searchCount Int [not null, default: 0]
  relatedKeywords String[] [not null]
  lastSearchedAt DateTime [default: `now()`, not null]
}

Table search_analytics [headercolor: #E74C3C] {
  id String [pk]
  userId String
  query String [not null]
  resultsCount Int [not null]
  clickedResults Json
  refinements Int [not null, default: 0]
  timeSpent Int
  wasSuccessful Boolean
  createdAt DateTime [default: `now()`, not null]
}

Table recent_searches [headercolor: #E74C3C] {
  id String [pk]
  userId String [not null]
  query String [not null]
  entityType String
  searchedAt DateTime [default: `now()`, not null]
}

Table search_facets [headercolor: #E74C3C] {
  id String [pk]
  facetType String [not null]
  facetKey String [not null]
  facetValue String [not null]
  displayName String [not null]
  count Int [not null, default: 0]
  sortOrder Int [not null, default: 0]
  isActive Boolean [not null, default: true]

  indexes {
    (facetType, facetKey, facetValue) [unique]
  }
}

Table synonyms [headercolor: #E74C3C] {
  id String [pk]
  term String [unique, not null]
  synonyms String[] [not null]
  category String
  isActive Boolean [not null, default: true]
  createdBy String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table search_suggestions [headercolor: #E74C3C] {
  id String [pk]
  query String [unique, not null]
  suggestion String [not null]
  searchCount Int [not null, default: 0]
  clickCount Int [not null, default: 0]
  relevanceScore Decimal [not null, default: 1]
  isActive Boolean [not null, default: true]
  lastSearchedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table search_queries [headercolor: #E74C3C] {
  id String [pk]
  userId String
  query String [not null]
  filters Json
  resultsCount Int [not null, default: 0]
  clickedResultId String
  clickPosition Int
  timestamp DateTime [default: `now()`, not null]
}

