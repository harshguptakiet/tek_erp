//// ======================================================
//// EXAMS & ASSESSMENTS
//// Module: 12-assessment-exams
//// Category: Assessment
//// Tables: 9
//// ======================================================

Enum DifficultyLevel {
  BEGINNER
  EASY
  MEDIUM
  HARD
  ADVANCED
  EXPERT
}

Enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_IN_BLANK
  SHORT_ANSWER
  LONG_ANSWER
  MATCH_FOLLOWING
  DIAGRAM_BASED
}

Enum ExamType {
  QUIZ
  MOCK_TEST
  ASSIGNMENT
  MID_TERM
  FINAL_EXAM
  COMPETITIVE_EXAM
  PRACTICE_TEST
}

Table exams [headercolor: #9B59B6] {
  id String [pk]
  teacherId String
  sectionId String
  title String [not null]
  description String
  examType ExamType [not null]
  board Board
  grade Int
  subjectId String
  totalMarks Decimal [not null]
  passingMarks Decimal
  duration Int [not null]
  hasNegativeMarking Boolean [not null, default: false]
  randomizeQuestions Boolean [not null, default: false]
  randomizeOptions Boolean [not null, default: false]
  showResultsImmediately Boolean [not null, default: true]
  showCorrectAnswers Boolean [not null, default: true]
  allowReview Boolean [not null, default: true]
  blueprint Json
  startTime DateTime
  endTime DateTime
  isPublished Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  teacher teacher_profiles
  section sections
  questions exam_questions [not null]
  attempts exam_attempts [not null]
  assignments exam_assignments [not null]
}

Table exam_questions [headercolor: #9B59B6] {
  id String [pk]
  examId String [not null]
  questionBankId String
  questionOrder Int [not null]
  question String [not null]
  questionType QuestionType [not null]
  options Json
  correctAnswer Json [not null]
  explanation String
  marks Decimal [not null]
  negativeMarks Decimal
  sectionName String
  exam exams [not null]
  questionBank question_bank
  answers exam_answers [not null]

  indexes {
    (examId, questionOrder) [unique]
  }
}

Table exam_answers [headercolor: #9B59B6] {
  id String [pk]
  attemptId String [not null]
  questionId String [not null]
  answer Json [not null]
  isCorrect Boolean
  marksAwarded Decimal
  timeTaken Int
  feedback String
  attempt exam_attempts [not null]
  question exam_questions [not null]

  indexes {
    (attemptId, questionId) [unique]
  }
}

Table exam_attempts [headercolor: #9B59B6] {
  id String [pk]
  examId String [not null]
  studentId String [not null]
  attemptNumber Int [not null, default: 1]
  startedAt DateTime [default: `now()`, not null]
  submittedAt DateTime
  timeTaken Int
  totalMarks Decimal
  obtainedMarks Decimal
  percentage Decimal
  rank Int
  isPassed Boolean
  evaluatedAt DateTime
  evaluatedBy String
  exam exams [not null]
  student student_profiles [not null]
  answers exam_answers [not null]

  indexes {
    (examId, studentId, attemptNumber) [unique]
  }
}

Table exam_assignments [headercolor: #9B59B6] {
  id String [pk]
  examId String [not null]
  studentId String
  classId String
  groupName String
  assignedAt DateTime [default: `now()`, not null]
  assignedBy String
  exam exams [not null]
}

Table question_bank [headercolor: #9B59B6] {
  id String [pk]
  creatorId String
  question String [not null]
  questionType QuestionType [not null]
  options Json
  correctAnswer Json [not null]
  explanation String
  board Board
  grade Int
  subjectId String
  chapterId String
  topicId String
  difficultyLevel DifficultyLevel
  bloomsTaxonomy String
  marks Decimal [not null]
  negativeMarks Decimal
  estimatedTime Int
  boardExamFrequency Int
  lastAppearedYear Int
  hasImage Boolean [not null, default: false]
  hasVideo Boolean [not null, default: false]
  hasAR Boolean [not null, default: false]
  hasVR Boolean [not null, default: false]
  mediaUrls String[] [not null]
  tags String[] [not null]
  keywords String[] [not null]
  usageCount Int [not null, default: 0]
  isPublic Boolean [not null, default: false]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  examQuestions exam_questions [not null]
}

Table question_tags [headercolor: #9B59B6] {
  id String [pk]
  name String [unique, not null]
  category String
  usageCount Int [not null, default: 0]
  createdAt DateTime [default: `now()`, not null]
}

Table exam_blueprints [headercolor: #9B59B6] {
  id String [pk]
  name String [not null]
  board Board
  grade Int
  subjectId String
  distribution Json [not null]
  totalMarks Decimal [not null]
  duration Int [not null]
  difficultyDistribution Json
  isTemplate Boolean [not null, default: false]
  createdBy String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table grading_rubrics [headercolor: #9B59B6] {
  id String [pk]
  name String [not null]
  description String
  criteria Json [not null]
  totalPoints Decimal [not null]
  isPublic Boolean [not null, default: false]
  createdBy String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

//// ======================================================
//// RELATIONSHIPS (Internal to this module)
//// ======================================================

Ref: exam_questions.examId > exams.id [delete: Cascade]
Ref: exam_questions.questionBankId > question_bank.id
Ref: exam_assignments.examId > exams.id [delete: Cascade]
Ref: exam_attempts.examId > exams.id [delete: Cascade]
Ref: exam_answers.attemptId > exam_attempts.id [delete: Cascade]
Ref: exam_answers.questionId > exam_questions.id [delete: Cascade]

