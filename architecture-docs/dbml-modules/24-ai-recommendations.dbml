//// ======================================================
//// AI RECOMMENDATIONS & PREDICTIONS
//// Module: 24-ai-recommendations
//// Category: Platform Services
//// Tables: 3
//// ======================================================

Table ai_recommendations [headercolor: #E74C3C] {
  id String [pk]
  userId String [not null]
  recommendationType String [not null]
  recommendations Json [not null]
  modelVersion String
  confidence Decimal
  reasons Json
  isAccepted Boolean
  acceptedAt DateTime
  clickedItems String[] [not null]
  generatedAt DateTime [default: `now()`, not null]
  expiresAt DateTime
}

Table ai_predictions [headercolor: #E74C3C] {
  id String [pk]
  studentId String [not null]
  predictionType String [not null]
  subjectId String
  examId String
  predictedValue Json [not null]
  confidence Decimal [not null]
  actualValue Json
  features Json
  modelVersion String [not null]
  predictedAt DateTime [default: `now()`, not null]
}

Table student_learning_styles [headercolor: #E74C3C] {
  id String [pk]
  studentId String [unique, not null]
  visualScore Decimal [not null]
  auditoryScore Decimal [not null]
  kinestheticScore Decimal [not null]
  readingWritingScore Decimal [not null]
  preferredContentTypes String[] [not null]
  optimalStudyTime String
  attentionSpan Int
  analysisDate DateTime [default: `now()`, not null]
  lastUpdated DateTime [not null]
}

